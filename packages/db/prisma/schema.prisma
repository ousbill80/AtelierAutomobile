// Schéma de référence : docs/02-modele-donnees.md
// Évolutions Phase 0 : docs/04-arbitrages-coherence.md §3
// Toute évolution future passe par une migration + mise à jour de 02-modele-donnees.md (même commit).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm, btree_gist]
}

// ═══════════════════════════════════════════════════════════════
// Organisation, sites, utilisateurs
// ═══════════════════════════════════════════════════════════════

model Organization {
  id                    String        @id @default(cuid(2))
  name                  String
  legalName             String?
  rccm                  String?
  ncc                   String? // numéro de compte contribuable
  taxRegime             TaxRegime     @default(RSI)
  vatRate               Int           @default(18) // en %
  vatEnabled            Boolean       @default(true)
  currency              String        @default("XOF")
  timezone              String        @default("Africa/Abidjan")
  phone                 String?
  email                 String?
  address               String?
  city                  String?       @default("Abidjan")
  logoUrl               String?
  invoiceFooter         String?
  plan                  PlanTier      @default(STARTER)
  operatingMode         OperatingMode @default(FULL) // REMINDERS_ONLY si le garage garde son ancien logiciel
  settings              Json          @default("{}") // préférences diverses (voir M15) : onboarding { step, skipped[] }, security { otpOnNewDevice: Role[] }
  onboardingCompletedAt DateTime?
  slug                  String?       @unique // M15 §14 (créé par M14 : /p/connexion?g={slug}) ; requis quand M15 sera livré
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  sites                  Site[]
  memberships            Membership[]
  customers              Customer[]
  customerContacts       CustomerContact[]
  vehicles               Vehicle[]
  mileageReadings        MileageReading[]
  vehicleEvents          VehicleEvent[]
  appointments           Appointment[]
  repairOrders           RepairOrder[]
  repairOrderLines       RepairOrderLine[]
  inspections            Inspection[]
  inspectionItems        InspectionItem[]
  inspectionTemplates    InspectionTemplate[]
  laborOperations        LaborOperation[]
  orStatusHistory        RepairOrderStatusHistory[] // M04 §14
  vehicleRecommendations VehicleRecommendation[] // M04 §14
  timeEntries            TimeEntry[]
  attendances            Attendance[]
  qualityChecks          QualityCheck[] // M06 §14
  partRequests           PartRequest[] // M06 §14
  workNotes              WorkNote[] // M06 §14
  techSyncOperations     TechSyncOperation[] // M06 (hors §14)
  quotes                 Quote[]
  quoteLines             QuoteLine[]
  products               Product[]
  stockLevels            StockLevel[]
  stockMovements         StockMovement[]
  suppliers              Supplier[]
  purchaseOrders         PurchaseOrder[]
  purchaseOrderLines     PurchaseOrderLine[]
  stockReservations      StockReservation[]
  stockCounts            StockCount[]
  stockCountLines        StockCountLine[]
  stockTransfers         StockTransfer[]
  stockTransferLines     StockTransferLine[]
  invoices               Invoice[]
  invoiceLines           InvoiceLine[]
  payments               Payment[]
  paymentAllocations     PaymentAllocation[]
  paymentLinks           PaymentLink[]
  cashSessions           CashSession[]
  expenses               Expense[]
  cashDrops              CashDrop[]
  refunds                Refund[]
  customerCredits        CustomerCredit[]
  paymentWebhookLogs     PaymentWebhookLog[]
  collectionCases        CollectionCase[]
  paymentPromises        PaymentPromise[]
  collectionNotes        CollectionNote[]
  creditOverrides        CreditOverride[]
  paymentAttributions    PaymentAttribution[]
  receivableSnapshots    ReceivableSnapshot[]
  reminderRules          ReminderRule[]
  reminders              Reminder[]
  reminderSuppressions   ReminderSuppression[]
  messageTemplates       MessageTemplate[]
  conversations          Conversation[]
  messages               Message[]
  messageStatusEvents    MessageStatusEvent[]
  messageAttempts        MessageAttempt[]
  quickReplies           QuickReply[]
  channelConfigs         ChannelConfig[]
  optOuts                OptOut[]
  paymentProviderConfigs PaymentProviderConfig[]
  fneConfig              FneConfig?
  dataSources            DataSource[]
  importJobs             ImportJob[]
  importRowErrors        ImportRowError[]
  externalRefs           ExternalRef[]
  apiKeys                ApiKey[]
  webhookEndpoints       WebhookEndpoint[]
  insuranceCompanies     InsuranceCompany[]
  insuranceClaims        InsuranceClaim[]
  claimActivities        ClaimActivity[]
  claimFollowUps         ClaimFollowUp[]
  attachments            Attachment[]
  documentSequences      DocumentSequence[]
  auditLogs              AuditLog[]
  domainEvents           DomainEvent[]
  notifications          Notification[]
  aiInteractions         AiInteraction[]
  aiSuggestions          AiSuggestion[]
  aiAssistantThreads     AiAssistantThread[]
  aiAssistantMessages    AiAssistantMessage[]
  automationRules        AutomationRule[]
  automationRuns         AutomationRun[]
  holidays               Holiday[]
  portalTokens           PortalToken[]
  portalAccesses         PortalAccess[]
  portalSessions         PortalSession[]
  portalOtpChallenges    PortalOtpChallenge[]
  customerFeedbacks      CustomerFeedback[]
  resourceBlocks         ResourceBlock[]
  invitations            Invitation[]
  rolePermissions        RolePermission[]
  trustedDevices         TrustedDevice[]
  customerNotes          CustomerNote[]
  duplicateDismissals    DuplicateDismissal[]
  customerSegments       CustomerSegment[]
  vehicleMakes           VehicleMake[]
  vehicleModels          VehicleModel[]
}

enum TaxRegime {
  RNI
  RSI
  RMI
  ENTREPRENANT
}

enum PlanTier {
  STARTER
  PRO
  NETWORK
}

enum OperatingMode {
  FULL
  REMINDERS_ONLY
}

model Site {
  id             String   @id @default(cuid(2))
  organizationId String
  name           String // "Atelier Yopougon"
  code           String // "YOP" (préfixe de numérotation)
  address        String?
  commune        String?
  phone          String?
  whatsappNumber String?
  openingHours   Json     @default("{}") // { mon: [["08:00","18:00"]], ... }
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id])
  bays              Bay[]
  appointments      Appointment[]
  repairOrders      RepairOrder[]
  quotes            Quote[]
  stockLevels       StockLevel[]
  stockMovements    StockMovement[]
  purchaseOrders    PurchaseOrder[]
  stockReservations StockReservation[]
  stockCounts       StockCount[]
  transfersOut      StockTransfer[]    @relation("StockTransferFrom")
  transfersIn       StockTransfer[]    @relation("StockTransferTo")
  invoices          Invoice[]
  payments          Payment[]
  cashSessions      CashSession[]
  expenses          Expense[]
  cashDrops         CashDrop[] // M08 §14
  refunds           Refund[] // M08 §14
  insuranceClaims   InsuranceClaim[] // M16 §14
  holidays          Holiday[]
  resourceBlocks    ResourceBlock[]
  attendances       Attendance[] // M06 §14
  partRequests      PartRequest[] // M06 §14
  customerFeedbacks CustomerFeedback[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model Bay {
  // pont / poste de travail
  id             String   @id @default(cuid(2))
  organizationId String
  siteId         String
  name           String // "Pont 1", "Carrosserie", "Diagnostic"
  type           BayType  @default(LIFT)
  isActive       Boolean  @default(true)
  // M03 §14
  sortOrder      Int      @default(0) // ordre des colonnes du planning
  color          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  site           Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  appointments   Appointment[]
  repairOrders   RepairOrder[]
  resourceBlocks ResourceBlock[]

  @@index([organizationId, siteId])
}

enum BayType {
  LIFT
  DIAGNOSTIC
  BODYWORK
  PAINT
  WASH
  OTHER
}

model User {
  id                       String    @id @default(cuid(2))
  name                     String
  email                    String?   @unique
  phone                    String?   @unique // E.164
  // Mot de passe NON stocké ici : Better Auth le garde dans Account.password
  // (providerId "credential"), cf. 04-arbitrages-coherence.md A6.
  emailVerifiedAt          DateTime?
  phoneVerifiedAt          DateTime?
  avatarUrl                String?
  locale                   String    @default("fr")
  isActive                 Boolean   @default(true)
  failedLoginCount         Int       @default(0)
  lockedUntil              DateTime?
  lockCount                Int       @default(0) // récidives depuis le dernier succès (RG-M01-05)
  lastLoginAt              DateTime?
  lastActiveOrganizationId String?
  lastActiveSiteId         String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  memberships Membership[]
  auditLogs   AuditLog[]
  sessions    Session[]
  accounts    Account[]
}

model Membership {
  id                 String    @id @default(cuid(2))
  organizationId     String
  userId             String
  role               Role
  permissions        String[] // surcharges explicites "module:action"
  siteIds            String[] // vide = tous les sites
  hourlyCost         Int? // coût horaire interne (mécaniciens)
  skills             String[] // "moteur", "électricité", "climatisation", "carrosserie"
  pinHash            String? // M01/M06 : code PIN atelier (connexion tablette)
  pinFailedCount     Int       @default(0)
  invitedById        String? // Membership.id de l'invitant
  isActive           Boolean   @default(true)
  deactivatedAt      DateTime?
  deactivationReason String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  mileageReadingsCreated      MileageReading[]      @relation("MileageReadingCreatedBy")
  vehicleEventsCreated        VehicleEvent[]        @relation("VehicleEventCreatedBy")
  appointmentsAsAdvisor       Appointment[]         @relation("AppointmentAdvisor")
  appointmentsAsMechanic      Appointment[]         @relation("AppointmentMechanic")
  appointmentsCreated         Appointment[]         @relation("AppointmentCreatedBy")
  resourceBlocksFor           ResourceBlock[]       @relation("ResourceBlockMembership")
  resourceBlocksCreated       ResourceBlock[]       @relation("ResourceBlockCreatedBy")
  repairOrdersAsAdvisor       RepairOrder[]         @relation("RepairOrderAdvisor")
  repairOrdersAsQc            RepairOrder[]         @relation("RepairOrderQc")
  repairOrderLinesAssigned    RepairOrderLine[]     @relation("RepairOrderLineAssignee")
  inspectionsPerformed        Inspection[]          @relation("InspectionPerformedBy")
  timeEntries                 TimeEntry[]
  attendances                 Attendance[]
  quotesCreated               Quote[]               @relation("QuoteCreatedBy")
  stockMovementsCreated       StockMovement[]       @relation("StockMovementCreatedBy")
  stockReservationsCreated    StockReservation[]    @relation("StockReservationCreatedBy")
  stockCountsValidated        StockCount[]          @relation("StockCountValidatedBy")
  stockCountsCreated          StockCount[]          @relation("StockCountCreatedBy")
  stockCountLinesCounted      StockCountLine[]      @relation("StockCountLineCountedBy")
  stockTransfersCreated       StockTransfer[]       @relation("StockTransferCreatedBy")
  paymentsReceived            Payment[]             @relation("PaymentReceivedBy")
  cashSessionsOpened          CashSession[]         @relation("CashSessionOpenedBy")
  cashSessionsClosed          CashSession[]         @relation("CashSessionClosedBy")
  expensesCreated             Expense[]             @relation("ExpenseCreatedBy")
  expensesApproved            Expense[]             @relation("ExpenseApprovedBy")
  cashSessionsReviewed        CashSession[]         @relation("CashSessionReviewedBy")
  cashDropsCreated            CashDrop[]            @relation("CashDropCreatedBy")
  refundsCreated              Refund[]              @relation("RefundCreatedBy")
  collectionCasesAssigned     CollectionCase[]      @relation("CollectionCaseAssignee")
  paymentPromisesCreated      PaymentPromise[]      @relation("PaymentPromiseCreatedBy")
  collectionNotesCreated      CollectionNote[]      @relation("CollectionNoteCreatedBy")
  remindersApproved           Reminder[]            @relation("ReminderApprovedBy")
  remindersEdited             Reminder[]            @relation("ReminderEditedBy")
  reminderSuppressionsCreated ReminderSuppression[] @relation("ReminderSuppressionCreatedBy")
  conversationsAssigned       Conversation[]        @relation("ConversationAssignee")
  messagesSent                Message[]             @relation("MessageSentBy")
  importJobsCreated           ImportJob[]           @relation("ImportJobCreatedBy")
  attachmentsCreated          Attachment[]          @relation("AttachmentCreatedBy")
  notifications               Notification[]
  aiInteractionsCreated       AiInteraction[]       @relation("AiInteractionCreatedBy")
  aiSuggestionsDecided        AiSuggestion[]        @relation("AiSuggestionDecidedBy")
  aiAssistantThreads          AiAssistantThread[]
  automationRulesCreated      AutomationRule[]      @relation("AutomationRuleCreatedBy")
  invoicesCreated             Invoice[]             @relation("InvoiceCreatedBy")
  portalTokensCreated         PortalToken[]         @relation("PortalTokenCreatedBy")
  paymentLinksCreated         PaymentLink[]         @relation("PaymentLinkCreatedBy")
  customerNotesCreated        CustomerNote[]        @relation("CustomerNoteCreatedBy")
  duplicateDismissalsCreated  DuplicateDismissal[]  @relation("DuplicateDismissalDismissedBy")
  customerSegmentsCreated     CustomerSegment[]     @relation("CustomerSegmentCreatedBy")
  quickRepliesCreated         QuickReply[]          @relation("QuickReplyCreatedBy")
  qualityChecks               QualityCheck[]        @relation("QualityCheckBy") // M06 §14
  partRequestsCreated         PartRequest[]         @relation("PartRequestBy") // M06 §14
  partRequestsHandled         PartRequest[]         @relation("PartRequestHandledBy") // M06 §14
  workNotesWritten            WorkNote[]            @relation("WorkNoteAuthor") // M06 §14
  workNotesApproved           WorkNote[]            @relation("WorkNoteApprovedBy") // M06 §14

  @@unique([organizationId, userId])
  @@index([organizationId])
}

enum Role {
  OWNER
  MANAGER
  ADVISOR
  MECHANIC
  STOREKEEPER
  CASHIER
  ACCOUNTANT
}

// ═══════════════════════════════════════════════════════════════
// Clients et véhicules
// ═══════════════════════════════════════════════════════════════

enum RecordOrigin {
  NATIVE
  IMPORTED
  API
  SYNC
}

model Customer {
  id                    String       @id @default(cuid(2))
  organizationId        String
  type                  CustomerType @default(INDIVIDUAL)
  firstName             String?
  lastName              String?
  companyName           String?
  displayName           String // calculé : "Kouassi Jean-Marc" ou "SOTRA Logistique SARL"
  civility              Civility?
  phone                 String? // E.164, principal
  phone2                String?
  hasWhatsapp           Boolean? // null = inconnu, détecté au 1er envoi
  whatsappPhone         String? // si différent
  email                 String?
  address               String?
  commune               String?
  ncc                   String? // entreprises
  rccm                  String?
  preferredChannel      Channel? // null = suit l'ordre par défaut
  remindersConsent      Boolean      @default(true)
  marketingConsent      Boolean      @default(false)
  optedOutAt            DateTime? // a répondu STOP
  doNotRemind           Boolean      @default(false) // décision interne
  doNotRemindReason     String?
  paymentTermsDays      Int          @default(0) // 0 = comptant
  creditLimit           Int? // en FCFA
  priceListId           String?
  discountRate          Int? // remise par défaut en %
  riskScore             Int? // 0-100, calculé (M09/M17)
  // M17 §14
  riskFactors           Json? // [{ code, points, label }]
  riskScoredAt          DateTime?
  bestSendHour          Int? // 0-23, heure locale optimale (RG-M17-16)
  bestChannel           Channel? // canal appris (≠ preferredChannel manuel)
  tags                  String[]
  notes                 String?
  source                String? // "import", "portail", "comptoir"
  origin                RecordOrigin @default(NATIVE)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  deletedAt             DateTime?
  // M02 §14
  consentUpdatedAt      DateTime?
  consentSource         String? // counter | phone | whatsapp_reply | portal | import | staff
  mergedIntoId          String? // client cible après fusion (RG-M02-08)
  anonymizedAt          DateTime?
  lastVisitAt           DateTime? // dénormalisé (dernier OR livré ou facture), pour tri/filtre
  // M11 §14
  hasWhatsappCheckedAt  DateTime?
  emailInvalidAt        DateTime?
  // M10 §14
  phoneInvalidAt        DateTime? // RG-M10-32 : 2 échecs définitifs sur ce numéro → plus d'envoi
  // M09 §14
  creditHold            Boolean      @default(false)
  creditHoldReason      String?
  riskComponents        Json? // { A, B, C, D, E } pour l'affichage (RG-M09-12)
  // M05 §14
  requiresPurchaseOrder Boolean      @default(false) // flotte : bon de commande client exigé

  organization      Organization       @relation(fields: [organizationId], references: [id])
  vehicles          Vehicle[]
  contacts          CustomerContact[]
  appointments      Appointment[]
  repairOrders      RepairOrder[]
  quotes            Quote[]
  invoices          Invoice[]
  payments          Payment[]
  refunds           Refund[] // M08 §14
  credits           CustomerCredit[] // M08 §14
  insurer           InsuranceCompany?  @relation("InsurerCustomer") // M16 : Customer d'une compagnie
  collectionCases   CollectionCase[]
  creditOverrides   CreditOverride[]
  reminders         Reminder[]
  conversations     Conversation[]
  messages          Message[]
  insuranceClaims   InsuranceClaim[]
  portalTokens      PortalToken[]
  customerNotes     CustomerNote[]
  // index trigram (migration SQL) :
  // CREATE INDEX customer_display_name_trgm ON "Customer" USING gin ("displayName" gin_trgm_ops);
  customerFeedbacks CustomerFeedback[]

  @@index([organizationId, displayName])
  @@index([organizationId, phone])
  @@index([organizationId, phone2])
  @@index([organizationId, email])
}

enum CustomerType {
  INDIVIDUAL
  COMPANY
}

enum Civility {
  M
  MME
  MLLE
}

enum Channel {
  WHATSAPP
  SMS
  EMAIL
}

model CustomerContact {
  // interlocuteurs d'une entreprise
  id                String    @id @default(cuid(2))
  organizationId    String
  customerId        String
  name              String
  role              String? // "Responsable flotte", "Comptabilité"
  phone             String?
  phone2            String?
  email             String?
  receivesInvoices  Boolean   @default(false)
  receivesReminders Boolean   @default(false)
  isPrimary         Boolean   @default(false)
  portalAccess      Boolean   @default(false) // M14 : accès vue flotte par OTP (US-M14-09)
  createdAt         DateTime  @default(now())
  deletedAt         DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([organizationId, customerId])
}

model Vehicle {
  id                        String        @id @default(cuid(2))
  organizationId            String
  customerId                String
  plate                     String // normalisée : majuscules, sans espaces multiples
  plateCompact              String        @default("") // "2547GH01" — unicité et recherche (RG-M02-05)
  plateType                 PlateType     @default(STANDARD)
  usage                     VehicleUsage  @default(PRIVATE)
  vin                       String?
  make                      String // Toyota
  model                     String // Corolla
  makeId                    String? // lien catalogue (facultatif, make/model restent la vérité affichée)
  modelId                   String?
  version                   String?
  year                      Int?
  firstRegistrationDate     DateTime?     @db.Date
  fuel                      FuelType?
  transmission              Transmission?
  engineCode                String?
  color                     String?
  fleetNumber               String? // n° interne flotte client
  driverName                String?
  driverPhone               String?
  // Kilométrage
  currentMileage            Int?
  currentMileageAt          DateTime?
  avgKmPerDay               Float? // calculé à partir des relevés
  estimatedMileage          Int? // estimé du jour (worker)
  odometerOffset            Int           @default(0) // après remplacement de compteur (RG-M02-09)
  odometerInMiles           Boolean       @default(false)
  // Visite technique
  inspectionLastDate        DateTime?     @db.Date
  inspectionExpiryDate      DateTime?     @db.Date
  inspectionCenter          String?
  // Révision
  serviceIntervalKm         Int? // ex. 10000
  serviceIntervalMonths     Int? // ex. 6
  lastServiceDate           DateTime?     @db.Date
  lastServiceMileage        Int?
  nextServiceDueDate        DateTime?     @db.Date // calculé (M10)
  nextServiceDueMileage     Int? // calculé
  nextServiceTrigger        String? // "DATE" | "MILEAGE" (RG-M02-13)
  // M10 §14
  serviceDueBasis           String? // "date" | "km" (laquelle a déterminé l'échéance)
  inspectionExpiryEstimated Boolean       @default(false) // déduite de la dernière VT (RG-M10-30)
  dataQualityFlags          String[] // "inspection_date_suspect", "duplicate_plate"
  // Assurance
  insuranceCompanyId        String?
  insuranceExpiryDate       DateTime?     @db.Date
  insurancePolicyNumber     String?
  notes                     String?
  mergedIntoId              String? // véhicule cible après fusion d'un doublon (RG-M02-08)
  origin                    RecordOrigin  @default(NATIVE)
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt
  deletedAt                 DateTime?

  organization     Organization      @relation(fields: [organizationId], references: [id])
  customer         Customer          @relation(fields: [customerId], references: [id])
  insuranceCompany InsuranceCompany? @relation(fields: [insuranceCompanyId], references: [id])
  vehicleMake      VehicleMake?      @relation(fields: [makeId], references: [id])
  vehicleModel     VehicleModel?     @relation(fields: [modelId], references: [id])
  mileageReadings  MileageReading[]
  events           VehicleEvent[]
  appointments     Appointment[]
  repairOrders     RepairOrder[]
  quotes           Quote[]
  invoices         Invoice[]
  reminders        Reminder[]
  insuranceClaims  InsuranceClaim[]
  customerNotes    CustomerNote[]
  // unicité partielle + index trigram (migration SQL) :
  // CREATE UNIQUE INDEX vehicle_plate_unique ON "Vehicle" ("organizationId","plateCompact")
  //   WHERE "deletedAt" IS NULL AND "plateType" <> 'NONE';
  // CREATE INDEX vehicle_plate_trgm ON "Vehicle" USING gin ("plateCompact" gin_trgm_ops);

  @@index([organizationId, plate])
  @@index([organizationId, plateCompact])
  @@index([organizationId, vin])
  @@index([organizationId, inspectionExpiryDate])
  @@index([organizationId, nextServiceDueDate])
  @@index([organizationId, customerId])
}

enum PlateType {
  STANDARD
  TEMPORARY
  DIPLOMATIC
  GOVERNMENT
  FOREIGN
  NONE
  OTHER
}

enum VehicleUsage {
  PRIVATE
  TAXI
  TRANSPORT
  UTILITY
  RENTAL
  OTHER
}

enum FuelType {
  PETROL
  DIESEL
  HYBRID
  ELECTRIC
  LPG
  OTHER
}

enum Transmission {
  MANUAL
  AUTOMATIC
}

model MileageReading {
  id             String        @id @default(cuid(2))
  organizationId String
  vehicleId      String
  mileage        Int
  readAt         DateTime
  source         MileageSource
  repairOrderId  String?
  createdById    String?
  isOutlier      Boolean       @default(false)
  createdAt      DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  vehicle      Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  repairOrder  RepairOrder? @relation(fields: [repairOrderId], references: [id])
  createdBy    Membership?  @relation("MileageReadingCreatedBy", fields: [createdById], references: [id])

  @@index([organizationId, vehicleId])
  @@index([vehicleId, readAt])
}

enum MileageSource {
  RECEPTION
  IMPORT
  CUSTOMER
  MANUAL
  INVOICE
}

model VehicleEvent {
  // historique libre (VT faite, accident, changement de propriétaire)
  id             String   @id @default(cuid(2))
  organizationId String
  vehicleId      String
  type           String
  occurredAt     DateTime
  data           Json     @default("{}")
  createdById    String?

  organization Organization @relation(fields: [organizationId], references: [id])
  vehicle      Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  createdBy    Membership?  @relation("VehicleEventCreatedBy", fields: [createdById], references: [id])

  @@index([organizationId, vehicleId])
}

model CustomerNote {
  // notes internes datées (chronologie, RG-M02-10 US-M02-10)
  id             String    @id @default(cuid(2))
  organizationId String
  customerId     String
  vehicleId      String?
  body           String
  pinned         Boolean   @default(false)
  createdById    String?
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicle      Vehicle?     @relation(fields: [vehicleId], references: [id])
  createdBy    Membership?  @relation("CustomerNoteCreatedBy", fields: [createdById], references: [id])

  @@index([organizationId, customerId])
}

model DuplicateDismissal {
  // paires de doublons ignorées (RG-M02-07)
  id             String   @id @default(cuid(2))
  organizationId String
  entity         String // customer | vehicle
  idA            String // plus petit des deux id (ordre lexical)
  idB            String
  dismissedById  String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  dismissedBy  Membership?  @relation("DuplicateDismissalDismissedBy", fields: [dismissedById], references: [id])

  @@unique([organizationId, entity, idA, idB])
}

model CustomerSegment {
  // segments enregistrés (M10 campagnes, M12 ; RG-M02-14)
  id             String   @id @default(cuid(2))
  organizationId String
  name           String
  filters        Json // mêmes clés que customer.list / vehicle.list
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  createdBy    Membership?  @relation("CustomerSegmentCreatedBy", fields: [createdById], references: [id])
}

model VehicleMake {
  // catalogue marques (RG-M02-20) ; organizationId null = catalogue global (platform)
  id             String  @id @default(cuid(2))
  organizationId String?
  name           String // "Toyota"
  isActive       Boolean @default(true)

  organization Organization?  @relation(fields: [organizationId], references: [id])
  models       VehicleModel[]
  vehicles     Vehicle[]

  @@unique([organizationId, name])
}

model VehicleModel {
  id                    String    @id @default(cuid(2))
  organizationId        String?
  makeId                String
  name                  String // "Corolla"
  yearFrom              Int?
  yearTo                Int?
  defaultFuel           FuelType?
  serviceIntervalKm     Int? // 10000
  serviceIntervalMonths Int? // 12
  isActive              Boolean   @default(true)

  organization Organization? @relation(fields: [organizationId], references: [id])
  make         VehicleMake   @relation(fields: [makeId], references: [id], onDelete: Cascade)
  vehicles     Vehicle[]

  @@unique([makeId, organizationId, name])
}

// ═══════════════════════════════════════════════════════════════
// Rendez-vous
// ═══════════════════════════════════════════════════════════════

model Appointment {
  id                String            @id @default(cuid(2))
  organizationId    String
  siteId            String
  customerId        String
  vehicleId         String?
  bayId             String?
  advisorId         String? // Membership.id
  startsAt          DateTime
  endsAt            DateTime
  type              AppointmentType
  status            AppointmentStatus @default(BOOKED)
  source            AppointmentSource @default(STAFF)
  reminderId        String? // relance à l'origine du RDV (attribution M12)
  notes             String?
  repairOrderId     String? // OR créé à l'arrivée
  // M03 §14
  mechanicId        String? // Membership.id du mécanicien prévu
  complaint         String? // motif / doléances (repris dans l'OR)
  laborOperationIds String[] // opérations prévues (durée, devis)
  quoteId           String? // RDV planifié pour exécuter un devis accepté (relation posée par M05)
  confirmedAt       DateTime?
  confirmedVia      String? // phone | whatsapp | sms | portal | in_person
  arrivedAt         DateTime?
  cancelledAt       DateTime?
  cancelledBy       String? // CUSTOMER | GARAGE
  cancelReason      String?
  noShowAt          DateTime?
  completedAt       DateTime?
  groupId           String? // RDV groupés (flotte)
  overbooked        Boolean           @default(false) // surréservation volontaire
  outsideHours      Boolean           @default(false)
  publicToken       String?           @unique // hash du jeton PortalToken (A2), raccourci de recherche
  createdById       String? // Membership.id
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  organization            Organization  @relation(fields: [organizationId], references: [id])
  site                    Site          @relation(fields: [siteId], references: [id])
  customer                Customer      @relation(fields: [customerId], references: [id])
  vehicle                 Vehicle?      @relation(fields: [vehicleId], references: [id])
  bay                     Bay?          @relation(fields: [bayId], references: [id])
  advisor                 Membership?   @relation("AppointmentAdvisor", fields: [advisorId], references: [id])
  mechanic                Membership?   @relation("AppointmentMechanic", fields: [mechanicId], references: [id])
  createdBy               Membership?   @relation("AppointmentCreatedBy", fields: [createdById], references: [id])
  reminder                Reminder?     @relation("AppointmentReminder", fields: [reminderId], references: [id])
  repairOrder             RepairOrder?  @relation("AppointmentResultingOrder", fields: [repairOrderId], references: [id])
  originatingRepairOrders RepairOrder[] @relation("RepairOrderOrigin")
  linkedReminders         Reminder[]    @relation("ReminderAppointment")

  // Contrainte d'exclusion (migration SQL, extension btree_gist, RG-M03-02) :
  // ALTER TABLE "Appointment" ADD CONSTRAINT appointment_no_overlap
  //   EXCLUDE USING gist ("bayId" WITH =, tsrange("startsAt","endsAt",'[)') WITH &&)
  //   WHERE ("bayId" IS NOT NULL AND status NOT IN ('CANCELLED','NO_SHOW') AND NOT overbooked);
  @@index([organizationId, siteId, startsAt])
  @@index([organizationId, customerId])
  @@index([organizationId, status, startsAt])
  @@index([organizationId, groupId])
}

model ResourceBlock {
  // M03 §14 — indisponibilités : pont, mécanicien ou site entier
  id             String   @id @default(cuid(2))
  organizationId String
  siteId         String
  bayId          String?
  membershipId   String? // mécanicien absent
  startsAt       DateTime
  endsAt         DateTime
  reason         String // "Maintenance pont", "Congé", "Formation"
  createdById    String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  site         Site         @relation(fields: [siteId], references: [id])
  bay          Bay?         @relation(fields: [bayId], references: [id])
  membership   Membership?  @relation("ResourceBlockMembership", fields: [membershipId], references: [id])
  createdBy    Membership?  @relation("ResourceBlockCreatedBy", fields: [createdById], references: [id])

  @@index([organizationId, siteId, startsAt])
}

enum AppointmentType {
  SERVICE
  INSPECTION_PREP
  REPAIR
  DIAGNOSTIC
  BODYWORK
  TIRES
  OTHER
}

enum AppointmentStatus {
  BOOKED
  CONFIRMED
  ARRIVED
  NO_SHOW
  CANCELLED
  COMPLETED
}

enum AppointmentSource {
  STAFF
  PHONE
  WHATSAPP
  PORTAL
  REMINDER
}

// ═══════════════════════════════════════════════════════════════
// Ordres de réparation
// ═══════════════════════════════════════════════════════════════

model RepairOrder {
  id                     String            @id @default(cuid(2))
  organizationId         String
  siteId                 String
  number                 String // OR-YOP-2026-00042
  customerId             String
  vehicleId              String
  appointmentId          String?
  advisorId              String?
  bayId                  String?
  cashOnly               Boolean           @default(false) // M09 §14 : OR ouvert sous blocage crédit sans dérogation
  status                 RepairOrderStatus @default(DRAFT)
  priority               Priority          @default(NORMAL)
  mileageIn              Int?
  fuelLevel              Int? // 0-8 (huitièmes)
  complaint              String? // doléances du client
  diagnosis              String?
  checkIn                Json              @default("{}") // état des lieux : rayures, objets, accessoires (M04)
  customerSignatureUrl   String?
  signedAt               DateTime?
  promisedAt             DateTime? // date de restitution promise
  startedAt              DateTime?
  completedAt            DateTime?
  deliveredAt            DateTime?
  qcById                 String?
  qcAt                   DateTime?
  insuranceClaimId       String?
  internalNotes          String?
  totalEstimate          Int               @default(0)
  origin                 RecordOrigin      @default(NATIVE)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  deletedAt              DateTime?
  // M04 §14
  publicToken            String?           @unique // hash du jeton portail (A2) : suivi client / signature à distance
  isComeback             Boolean           @default(false)
  comebackOfId           String? // OR d'origine (retour sur travaux)
  warrantyDecision       WarrantyDecision?
  warrantyDecisionReason String?
  waitingPartsSince      DateTime?
  qcChecklist            Json? // [{ key, label, result: OK|NOK|NA }] + roadTest
  deliverySignatureUrl   String?
  cancelledAt            DateTime?
  cancelReason           String?
  invoicedAt             DateTime?
  createdById            String? // Membership.id
  readyAt                DateTime? // M04 : passage en READY (ancre VEHICLE_READY M10, frais de gardiennage)
  clientRequestId        String? // M04 : idempotence de la réception hors-ligne (US-M04-01)

  organization          Organization               @relation(fields: [organizationId], references: [id])
  site                  Site                       @relation(fields: [siteId], references: [id])
  customer              Customer                   @relation(fields: [customerId], references: [id])
  vehicle               Vehicle                    @relation(fields: [vehicleId], references: [id])
  appointment           Appointment?               @relation("RepairOrderOrigin", fields: [appointmentId], references: [id])
  advisor               Membership?                @relation("RepairOrderAdvisor", fields: [advisorId], references: [id])
  bay                   Bay?                       @relation(fields: [bayId], references: [id])
  qcBy                  Membership?                @relation("RepairOrderQc", fields: [qcById], references: [id])
  insuranceClaim        InsuranceClaim?            @relation(fields: [insuranceClaimId], references: [id])
  lines                 RepairOrderLine[]
  inspections           Inspection[]
  mileageReadings       MileageReading[]
  quotes                Quote[]
  invoices              Invoice[]
  timeEntries           TimeEntry[]
  qualityChecks         QualityCheck[] // M06 §14
  partRequests          PartRequest[] // M06 §14
  workNotes             WorkNote[] // M06 §14
  purchaseOrders        PurchaseOrder[]
  resultingAppointments Appointment[]              @relation("AppointmentResultingOrder")
  stockMovements        StockMovement[]
  comebackOf            RepairOrder?               @relation("RepairOrderComeback", fields: [comebackOfId], references: [id])
  comebacks             RepairOrder[]              @relation("RepairOrderComeback")
  statusHistory         RepairOrderStatusHistory[]
  customerFeedback      CustomerFeedback?

  @@unique([organizationId, number])
  @@unique([organizationId, clientRequestId])
  @@index([organizationId, status])
  @@index([organizationId, vehicleId])
  @@index([organizationId, siteId, status])
  @@index([organizationId, createdAt]) // M12 : OR ouverts (RG-M12-12)
  @@index([organizationId, deliveredAt]) // M12 : OR livrés (RG-M12-12)
}

enum WarrantyDecision {
  COVERED
  NOT_COVERED
  PARTIAL
}

enum RepairOrderStatus {
  DRAFT
  CHECKED_IN
  DIAGNOSING
  AWAITING_APPROVAL
  APPROVED
  IN_PROGRESS
  WAITING_PARTS
  QUALITY_CHECK
  READY
  DELIVERED
  INVOICED
  CANCELLED
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model RepairOrderLine {
  id                    String        @id @default(cuid(2))
  organizationId        String
  repairOrderId         String
  type                  LineType
  productId             String?
  laborOperationId      String?
  description           String
  quantity              Float // heures pour la MO, unités pour les pièces
  unitPrice             Int
  discountRate          Int           @default(0)
  vatRate               Int
  assignedToId          String? // Membership.id du mécanicien
  status                LineStatus    @default(PENDING)
  approval              ApprovalState @default(NOT_REQUIRED)
  quoteLineId           String?
  payer                 Payer         @default(CUSTOMER)
  sortOrder             Int           @default(0)
  // M04 §14
  isCustomerSupplied    Boolean       @default(false) // pièce fournie par le client (unitPrice 0, non garantie)
  costPrice             Int? // coût unitaire (sous-traitance, pièce hors stock)
  supplierId            String? // sous-traitant / fournisseur ponctuel (relation branchée par M07)
  subcontractStatus     String? // TO_SEND | SENT | RETURNED
  subcontractExpectedAt DateTime?
  approvalSource        String? // CHECK_IN | PRE_AUTHORIZED | QUOTE | PHONE | IN_PERSON
  inspectionItemId      String?
  warrantyMonths        Int?
  warrantyKm            Int?
  warrantyUntilDate     DateTime?     @db.Date // figé à la livraison
  warrantyUntilMileage  Int?
  completedAt           DateTime?
  completedById         String? // Membership.id
  cancelReason          String? // M04 : motif d'annulation/refus de la ligne (historique)
  // M06 §14 — sous-traitance : subcontractorId/subcontractCost/subcontractDueAt du PRD sont
  // les champs M04 supplierId/costPrice/subcontractExpectedAt ; subcontractStatus (M04, texte)
  // prend les valeurs de SubcontractStatus (TO_SEND | SENT | RETURNED | CANCELLED).
  subcontractReturnedAt DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id])
  repairOrder    RepairOrder     @relation(fields: [repairOrderId], references: [id], onDelete: Cascade)
  product        Product?        @relation(fields: [productId], references: [id])
  laborOperation LaborOperation? @relation(fields: [laborOperationId], references: [id])
  assignedTo     Membership?     @relation("RepairOrderLineAssignee", fields: [assignedToId], references: [id])
  quoteLine      QuoteLine?      @relation(fields: [quoteLineId], references: [id])
  timeEntries    TimeEntry[]
  partRequests   PartRequest[] // M06 §14
  workNotes      WorkNote[] // M06 §14

  @@index([organizationId, repairOrderId])
  @@index([repairOrderId])
}

enum LineType {
  LABOR
  PART
  SUBCONTRACT
  FEE
  CONSUMABLE
}

enum LineStatus {
  PENDING
  IN_PROGRESS
  DONE
  CANCELLED
}

enum ApprovalState {
  NOT_REQUIRED
  PENDING
  APPROVED
  DECLINED
}

enum Payer {
  CUSTOMER
  INSURANCE
  WARRANTY
  INTERNAL
}

model Inspection {
  // inspection multipoints
  id             String    @id @default(cuid(2))
  organizationId String
  repairOrderId  String
  templateId     String?
  performedById  String?
  completedAt    DateTime?
  createdAt      DateTime  @default(now()) // M04 §14
  summary        Json? // M04 §14 : { urgent, watch, ok, notChecked }

  organization Organization        @relation(fields: [organizationId], references: [id])
  repairOrder  RepairOrder         @relation(fields: [repairOrderId], references: [id], onDelete: Cascade)
  template     InspectionTemplate? @relation(fields: [templateId], references: [id])
  performedBy  Membership?         @relation("InspectionPerformedBy", fields: [performedById], references: [id])
  items        InspectionItem[]

  @@index([organizationId, repairOrderId])
}

model InspectionItem {
  id                    String           @id @default(cuid(2))
  organizationId        String
  inspectionId          String
  category              String // Freinage, Pneumatiques, Éclairage…
  label                 String // "Plaquettes avant"
  result                InspectionResult
  measurement           String?
  comment               String?
  photoUrls             String[]
  recommendedProductIds String[]
  recommendedLaborIds   String[]
  addedToQuote          Boolean          @default(false)
  shareWithCustomer     Boolean          @default(true) // M04 §14
  sortOrder             Int              @default(0) // M04 §14

  organization Organization @relation(fields: [organizationId], references: [id])
  inspection   Inspection   @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([organizationId, inspectionId])
}

enum InspectionResult {
  OK
  WATCH
  URGENT
  NOT_CHECKED
}

model InspectionTemplate {
  id             String  @id @default(cuid(2))
  organizationId String
  name           String
  items          Json // [{ category, label, measurementUnit?, recommendedLaborCode?, recommendedProductCategory? }]
  isDefault      Boolean @default(false) // M04 §14
  isActive       Boolean @default(true) // M04 §14

  organization Organization @relation(fields: [organizationId], references: [id])
  inspections  Inspection[]

  @@index([organizationId])
}

model LaborOperation {
  // catalogue de main-d'œuvre
  id                  String        @id @default(cuid(2))
  organizationId      String
  code                String
  name                String // "Vidange moteur + filtre"
  category            String?
  standardHours       Float // temps barème
  rateType            LaborRateType @default(STANDARD)
  fixedPrice          Int? // forfait éventuel
  isActive            Boolean       @default(true)
  // M05 §14
  customerDescription String? // explication par défaut pour le client
  defaultParts        Json          @default("[]") // [{ productId? , category?, quantity }]
  vehicleOverrides    Json          @default("[]") // [{ make, model?, yearFrom?, yearTo?, standardHours }]
  isServiceOperation  Boolean       @default(false) // compte comme « révision » (M02 RG-M02-13)
  requiredSkill       String? // M06 §14 : doit correspondre à une valeur de Membership.skills
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id])
  repairOrderLines RepairOrderLine[]
  quoteLines       QuoteLine[]
  invoiceLines     InvoiceLine[]

  @@unique([organizationId, code])
}

model RepairOrderStatusHistory {
  // M04 §14 — une ligne par transition de la machine à états
  id             String             @id @default(cuid(2))
  organizationId String
  repairOrderId  String
  fromStatus     RepairOrderStatus?
  toStatus       RepairOrderStatus
  transition     String
  reason         String?
  membershipId   String? // null = automatique
  createdAt      DateTime           @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  repairOrder  RepairOrder  @relation(fields: [repairOrderId], references: [id], onDelete: Cascade)

  @@index([repairOrderId, createdAt])
  @@index([organizationId])
}

model VehicleRecommendation {
  // M04 §14 — travaux conseillés non réalisés (relance M10 RECOMMENDED_WORK, A8)
  id               String           @id @default(cuid(2))
  organizationId   String
  vehicleId        String
  customerId       String
  repairOrderId    String?
  inspectionItemId String?
  quoteLineId      String?
  label            String // "Amortisseurs arrière"
  severity         InspectionResult // WATCH | URGENT
  estimatedAmount  Int? // TTC
  remindAt         DateTime?        @db.Date // défaut : +90 jours
  status           String           @default("OPEN") // OPEN | DONE | DISMISSED
  createdAt        DateTime         @default(now())
  resolvedAt       DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, vehicleId, status])
}

enum LaborRateType {
  STANDARD
  DIAGNOSTIC
  BODYWORK
  ELECTRICAL
}

model TimeEntry {
  // pointage mécanicien sur une tâche
  id                String        @id @default(cuid(2))
  organizationId    String
  membershipId      String
  repairOrderId     String
  repairOrderLineId String?
  startedAt         DateTime
  endedAt           DateTime?
  pauseMinutes      Int           @default(0)
  note              String?
  source            String        @default("tablet") // tablet | web | offline-sync
  // M06 §14
  kind              TimeEntryKind @default(WORK)
  pausedAt          DateTime?
  pauseReason       String? // parts | lunch | approval | other
  clientOpId        String?       @unique // idempotence de la synchro hors-ligne
  deviceId          String?
  needsReview       Boolean       @default(false)
  reviewReason      String? // M06 (hors §14) : motif du signalement (chevauchement, clôture auto…)

  organization    Organization     @relation(fields: [organizationId], references: [id])
  membership      Membership       @relation(fields: [membershipId], references: [id])
  repairOrder     RepairOrder      @relation(fields: [repairOrderId], references: [id], onDelete: Cascade)
  repairOrderLine RepairOrderLine? @relation(fields: [repairOrderLineId], references: [id])

  @@index([organizationId, repairOrderId])
  @@index([organizationId, membershipId])
  @@index([organizationId, membershipId, startedAt])
  @@index([organizationId, startedAt]) // M12 : heures pointées par site (RG-M12-14)
}

enum TimeEntryKind {
  WORK
  DIAGNOSTIC
  REWORK
}

model Attendance {
  // présence journalière
  id             String    @id @default(cuid(2))
  organizationId String
  membershipId   String
  date           DateTime  @db.Date
  clockIn        DateTime?
  clockOut       DateTime?
  // M06 §14
  siteId         String?
  breakMinutes   Int       @default(60)
  autoClosed     Boolean   @default(false)

  organization Organization @relation(fields: [organizationId], references: [id])
  membership   Membership   @relation(fields: [membershipId], references: [id])
  site         Site?        @relation(fields: [siteId], references: [id])

  @@unique([organizationId, membershipId, date])
  @@index([organizationId, membershipId, date])
}

// ───────────── M06 §14 — atelier : contrôle qualité, demandes de pièces, remarques ─────────────

model QualityCheck {
  id             String   @id @default(cuid(2))
  organizationId String
  repairOrderId  String
  checkedById    String // Membership.id
  result         QcResult
  checklist      Json     @default("{}") // { "road_test": true, "wheel_torque": true, … }
  comment        String?
  reworkLineIds  String[]
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  repairOrder  RepairOrder  @relation(fields: [repairOrderId], references: [id], onDelete: Cascade)
  checkedBy    Membership   @relation("QualityCheckBy", fields: [checkedById], references: [id])

  @@index([organizationId, repairOrderId])
}

enum QcResult {
  PASSED
  FAILED
}

model PartRequest {
  // demande de pièce tablette → magasin (traitée dans M07)
  id                String            @id @default(cuid(2))
  organizationId    String
  siteId            String
  repairOrderId     String
  repairOrderLineId String?
  requestedById     String // Membership.id
  productId         String?
  freeText          String? // si produit introuvable
  quantity          Float
  urgency           Priority          @default(NORMAL)
  status            PartRequestStatus @default(REQUESTED)
  handledById       String?
  purchaseOrderId   String?
  rejectReason      String?
  clientOpId        String?           @unique
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  organization    Organization     @relation(fields: [organizationId], references: [id])
  site            Site             @relation(fields: [siteId], references: [id])
  repairOrder     RepairOrder      @relation(fields: [repairOrderId], references: [id], onDelete: Cascade)
  repairOrderLine RepairOrderLine? @relation(fields: [repairOrderLineId], references: [id])
  requestedBy     Membership       @relation("PartRequestBy", fields: [requestedById], references: [id])
  handledBy       Membership?      @relation("PartRequestHandledBy", fields: [handledById], references: [id])
  product         Product?         @relation(fields: [productId], references: [id])

  @@index([organizationId, siteId, status])
  @@index([organizationId, repairOrderId])
}

enum PartRequestStatus {
  REQUESTED
  PREPARING
  ORDERED
  DELIVERED
  REJECTED
  CANCELLED
}

model WorkNote {
  // remarques mécanicien sur un OR / une ligne
  id                String   @id @default(cuid(2))
  organizationId    String
  repairOrderId     String
  repairOrderLineId String?
  authorId          String // Membership.id
  body              String
  visibleToCustomer Boolean  @default(false)
  approvedById      String? // conseiller ayant validé la diffusion
  clientOpId        String?  @unique
  createdAt         DateTime @default(now())

  organization    Organization     @relation(fields: [organizationId], references: [id])
  repairOrder     RepairOrder      @relation(fields: [repairOrderId], references: [id], onDelete: Cascade)
  repairOrderLine RepairOrderLine? @relation(fields: [repairOrderLineId], references: [id])
  author          Membership       @relation("WorkNoteAuthor", fields: [authorId], references: [id])
  approvedBy      Membership?      @relation("WorkNoteApprovedBy", fields: [approvedById], references: [id])

  @@index([organizationId, repairOrderId])
}

model TechSyncOperation {
  // M06 (hors §14) — journal des opérations tablette appliquées (RG-M06-14 : idempotence par
  // clientOpId pour toutes les opérations, y compris pause/reprise/inspection sans ligne créée).
  id             String    @id @default(cuid(2))
  organizationId String
  clientOpId     String
  membershipId   String // acteur (mécanicien identifié)
  deviceId       String?
  type           String // task.start | task.pause | … (TechOp)
  status         String // ok | rejected
  error          String?
  entityId       String?
  deviceAt       DateTime?
  appliedAt      DateTime // horodatage corrigé (serverOffset)
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, clientOpId])
  @@index([organizationId, membershipId, createdAt])
}

// ═══════════════════════════════════════════════════════════════
// Devis
// ═══════════════════════════════════════════════════════════════

model Quote {
  id                     String      @id @default(cuid(2))
  organizationId         String
  siteId                 String
  number                 String // DEV-YOP-2026-00017
  version                Int         @default(1)
  customerId             String
  vehicleId              String?
  repairOrderId          String?
  status                 QuoteStatus @default(DRAFT)
  validUntil             DateTime    @db.Date
  publicToken            String?     @unique
  sentAt                 DateTime?
  viewedAt               DateTime?
  decidedAt              DateTime?
  decisionChannel        String? // portal | whatsapp | in_person | phone
  signatureUrl           String?
  signerName             String?
  declineReason          String?
  subtotal               Int         @default(0)
  discountTotal          Int         @default(0)
  vatTotal               Int         @default(0)
  total                  Int         @default(0)
  insuranceShare         Int         @default(0)
  customerShare          Int         @default(0)
  notes                  String?
  createdById            String?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  // M17 §14 — explication client validée (RG-M17-19), affichée sur le portail
  customerExplanation    Json? // { groupKey: texte validé }
  // M05 §14
  origin                 QuoteOrigin @default(STANDALONE)
  inspectionId           String?
  insuranceClaimId       String?
  supersedesId           String? // version précédente
  supersededAt           DateTime? // renseigné quand une version plus récente existe
  globalDiscountRate     Int? // %
  globalDiscountAmount   Int? // FCFA (exclusif avec le taux)
  discountReason         String?
  discountApprovalStatus String? // NONE | PENDING | APPROVED | REJECTED
  discountApprovedById   String?
  sentVia                String? // WHATSAPP | SMS | EMAIL | WA_LINK | LINK_ONLY
  sentTo                 String? // adresse effective
  recipientContactId     String?
  decisionHash           String? // SHA-256 du contenu signé
  decisionIp             String?
  decisionUserAgent      String?
  decisionMessageId      String? // message WhatsApp servant de preuve
  recordedById           String? // membre ayant saisi une décision hors portail
  decisionCounterpart    String? // interlocuteur au téléphone
  acceptedTotal          Int         @default(0) // TTC des lignes acceptées (dénormalisé)
  depositAmount          Int?
  depositInvoiceId       String?
  customerPoNumber       String? // bon de commande du client entreprise
  convertedAt            DateTime?
  deletedAt              DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  site         Site         @relation(fields: [siteId], references: [id])
  customer     Customer     @relation(fields: [customerId], references: [id])
  vehicle      Vehicle?     @relation(fields: [vehicleId], references: [id])
  repairOrder  RepairOrder? @relation(fields: [repairOrderId], references: [id])
  createdBy    Membership?  @relation("QuoteCreatedBy", fields: [createdById], references: [id])
  lines        QuoteLine[]
  invoices     Invoice[]
  reminders    Reminder[]

  @@unique([organizationId, number, version])
  @@index([organizationId, status, sentAt])
  @@index([organizationId, repairOrderId])
  @@index([organizationId, customerId])
  @@index([organizationId, decidedAt]) // M12 : taux d'acceptation (RG-M12-13)
}

enum QuoteOrigin {
  REPAIR_ORDER
  INSPECTION
  STANDALONE
  APPOINTMENT
  INSURANCE
}

enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  PARTIALLY_ACCEPTED
  DECLINED
  EXPIRED
  CONVERTED
}

model QuoteLine {
  id                  String            @id @default(cuid(2))
  organizationId      String
  quoteId             String
  type                LineType
  productId           String?
  laborOperationId    String?
  description         String
  quantity            Float
  unitPrice           Int
  discountRate        Int               @default(0)
  vatRate             Int
  isOptional          Boolean           @default(false)
  priority            InspectionResult? // URGENT / WATCH pour l'affichage client
  accepted            Boolean? // null = pas encore décidé
  payer               Payer             @default(CUSTOMER)
  sortOrder           Int               @default(0)
  // M05 §14
  groupKey            String? // regroupe MO + pièces d'un même travail
  groupLabel          String? // "Plaquettes avant"
  requiresGroupKey    String? // dépendance (ex. disques nécessite plaquettes)
  customerExplanation String? // texte simple affiché au client
  inspectionItemId    String?
  photoAttachmentIds  String[]
  costPrice           Int? // coût unitaire estimé (marge)
  isCustomerSupplied  Boolean           @default(false)
  declineReason       String?
  lineSubtotal        Int               @default(0) // HT après remise (calculé)
  lineVat             Int               @default(0)
  lineTotal           Int               @default(0)

  organization     Organization      @relation(fields: [organizationId], references: [id])
  quote            Quote             @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product          Product?          @relation(fields: [productId], references: [id])
  laborOperation   LaborOperation?   @relation(fields: [laborOperationId], references: [id])
  repairOrderLines RepairOrderLine[]

  @@index([organizationId, quoteId])
  @@index([quoteId])
}

// ═══════════════════════════════════════════════════════════════
// Stock et achats
// ═══════════════════════════════════════════════════════════════

model Product {
  id                String    @id @default(cuid(2))
  organizationId    String
  sku               String
  name              String
  brand             String?
  oemReference      String?
  barcode           String?
  category          String? // Filtration, Freinage, Lubrifiants…
  unit              String    @default("pièce") // pièce, litre, kit
  purchasePrice     Int       @default(0) // dernier prix d'achat
  averageCost       Int       @default(0) // CMP
  salePrice         Int       @default(0)
  minSalePrice      Int?
  vatRate           Int       @default(18)
  minStock          Int       @default(0)
  reorderQty        Int?
  isStocked         Boolean   @default(true) // false = commandé à la demande
  compatibleWith    String[] // "Toyota Corolla 2014-2019"
  defaultSupplierId String?
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  // M07 §14
  quantityScale     Int       @default(1) // 10 pour litre/kg : quantités de stock en dixièmes (RG-M07-01)
  packSize          Int       @default(1) // conditionnement d'achat (en unités d'affichage)
  crossReferences   String[] // références équivalentes / anciennes
  lastIssuedAt      DateTime? // dénormalisé pour les dormantes (RG-M07-11)

  organization       Organization        @relation(fields: [organizationId], references: [id])
  defaultSupplier    Supplier?           @relation(fields: [defaultSupplierId], references: [id])
  stockLevels        StockLevel[]
  stockMovements     StockMovement[]
  purchaseOrderLines PurchaseOrderLine[]
  repairOrderLines   RepairOrderLine[]
  quoteLines         QuoteLine[]
  invoiceLines       InvoiceLine[]
  stockReservations  StockReservation[]
  stockCountLines    StockCountLine[]
  stockTransferLines StockTransferLine[]
  partRequests       PartRequest[] // M06 §14

  @@unique([organizationId, sku])
  @@index([organizationId, barcode])
  @@index([defaultSupplierId])
}

model StockLevel {
  id             String  @id @default(cuid(2))
  organizationId String
  siteId         String
  productId      String
  onHand         Int     @default(0)
  reserved       Int     @default(0) // réservé pour des OR
  binLocation    String? // "Étagère B3"
  // M07 §14 — surcharges par site (unités de base)
  minStock       Int?
  maxStock       Int?

  organization Organization @relation(fields: [organizationId], references: [id])
  site         Site         @relation(fields: [siteId], references: [id])
  product      Product      @relation(fields: [productId], references: [id])

  @@unique([siteId, productId])
  @@index([organizationId])
  @@index([productId])
}

model StockMovement {
  id                String            @id @default(cuid(2))
  organizationId    String
  siteId            String
  productId         String
  type              StockMovementType
  quantity          Int // positif entrée, négatif sortie
  unitCost          Int?
  repairOrderId     String?
  purchaseOrderId   String?
  reason            String?
  createdById       String?
  createdAt         DateTime          @default(now())
  // M07 §14
  costAfter         Int? // CMP après le mouvement (historique de valorisation, RG-M07-09)
  repairOrderLineId String? // ligne d'OR (M04), sans relation : branchée par l'étape 3.2
  reservationId     String?
  transferId        String?
  countId           String?
  reasonCode        String? // casse | perte | vol | peremption | demonte | erreur | autre

  organization  Organization      @relation(fields: [organizationId], references: [id])
  site          Site              @relation(fields: [siteId], references: [id])
  product       Product           @relation(fields: [productId], references: [id])
  repairOrder   RepairOrder?      @relation(fields: [repairOrderId], references: [id])
  purchaseOrder PurchaseOrder?    @relation(fields: [purchaseOrderId], references: [id])
  createdBy     Membership?       @relation("StockMovementCreatedBy", fields: [createdById], references: [id])
  reservation   StockReservation? @relation(fields: [reservationId], references: [id])
  transfer      StockTransfer?    @relation(fields: [transferId], references: [id])
  count         StockCount?       @relation(fields: [countId], references: [id])

  @@index([organizationId, siteId, productId])
  @@index([organizationId, productId, createdAt])
  @@index([organizationId, createdAt])
  @@index([repairOrderId])
  @@index([purchaseOrderId])
  @@index([reservationId])
  @@index([transferId])
  @@index([countId])
}

enum StockMovementType {
  PURCHASE_RECEIPT
  ISSUE_TO_RO
  RETURN_FROM_RO
  ADJUSTMENT
  TRANSFER_OUT
  TRANSFER_IN
  COUNT_CORRECTION
  SUPPLIER_RETURN
}

model Supplier {
  id               String  @id @default(cuid(2))
  organizationId   String
  name             String
  phone            String?
  whatsappPhone    String?
  email            String?
  address          String?
  paymentTermsDays Int     @default(0)
  notes            String?
  isActive         Boolean @default(true)

  organization   Organization    @relation(fields: [organizationId], references: [id])
  products       Product[]
  purchaseOrders PurchaseOrder[]

  @@index([organizationId])
}

model PurchaseOrder {
  id             String              @id @default(cuid(2))
  organizationId String
  siteId         String
  number         String // BC-YOP-2026-00008
  supplierId     String
  status         PurchaseOrderStatus @default(DRAFT)
  orderedAt      DateTime?
  expectedAt     DateTime?
  receivedAt     DateTime?
  repairOrderId  String? // commande liée à un OR
  total          Int                 @default(0)
  notes          String?
  createdAt      DateTime            @default(now()) // M07 §14 (tri des listes)

  organization   Organization        @relation(fields: [organizationId], references: [id])
  site           Site                @relation(fields: [siteId], references: [id])
  supplier       Supplier            @relation(fields: [supplierId], references: [id])
  repairOrder    RepairOrder?        @relation(fields: [repairOrderId], references: [id])
  lines          PurchaseOrderLine[]
  stockMovements StockMovement[]
  reservations   StockReservation[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([supplierId])
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

// M07 §14 — réservations de pièces pour un OR (RG-M07-04). `repairOrderId` /
// `repairOrderLineId` sans relation : les OR (M04) sont branchés par l'étape 3.2.
model StockReservation {
  id                String                 @id @default(cuid(2))
  organizationId    String
  siteId            String
  productId         String
  repairOrderId     String?
  repairOrderLineId String?
  quantity          Int // unités de base
  status            StockReservationStatus @default(RESERVED)
  purchaseOrderId   String? // commande attendue si BACKORDERED
  note              String?
  createdById       String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id])
  site           Site            @relation(fields: [siteId], references: [id])
  product        Product         @relation(fields: [productId], references: [id])
  purchaseOrder  PurchaseOrder?  @relation(fields: [purchaseOrderId], references: [id])
  createdBy      Membership?     @relation("StockReservationCreatedBy", fields: [createdById], references: [id])
  stockMovements StockMovement[]

  @@index([organizationId, siteId, productId, status])
  @@index([organizationId, repairOrderId])
  @@index([productId])
  @@index([purchaseOrderId])
}

enum StockReservationStatus {
  RESERVED
  BACKORDERED
  ISSUED
  RELEASED
}

// M07 §14 — inventaires (RG-M07-10), numérotés INV-{site}-{année}-{seq} (A4).
model StockCount {
  id             String           @id @default(cuid(2))
  organizationId String
  siteId         String
  number         String // INV-YOP-2026-00003
  scope          Json             @default("{}") // { categories?: [], bins?: [] } ; vide = complet
  status         StockCountStatus @default(DRAFT)
  startedAt      DateTime?
  submittedAt    DateTime?
  validatedAt    DateTime?
  validatedById  String?
  varianceValue  Int              @default(0)
  createdById    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization   Organization     @relation(fields: [organizationId], references: [id])
  site           Site             @relation(fields: [siteId], references: [id])
  validatedBy    Membership?      @relation("StockCountValidatedBy", fields: [validatedById], references: [id])
  createdBy      Membership?      @relation("StockCountCreatedBy", fields: [createdById], references: [id])
  lines          StockCountLine[]
  stockMovements StockMovement[]

  @@unique([organizationId, number])
  @@index([organizationId, siteId, status])
}

enum StockCountStatus {
  DRAFT
  IN_PROGRESS
  SUBMITTED
  VALIDATED
  CANCELLED
}

model StockCountLine {
  id              String    @id @default(cuid(2))
  organizationId  String
  stockCountId    String
  productId       String
  expectedQty     Int // onHand figé au démarrage (+ mouvements avant comptage)
  countedQty      Int?
  unitCost        Int // CMP au démarrage
  movedAfterCount Boolean   @default(false) // mouvement survenu après le comptage (RG-M07-10)
  countedById     String?
  countedAt       DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  stockCount   StockCount   @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id])
  countedBy    Membership?  @relation("StockCountLineCountedBy", fields: [countedById], references: [id])

  @@unique([stockCountId, productId])
  @@index([organizationId, stockCountId])
  @@index([productId])
}

// M07 §14 — transferts inter-sites (RG-M07-15), numérotés TR-{site}-{année}-{seq} (A4).
model StockTransfer {
  id             String              @id @default(cuid(2))
  organizationId String
  number         String // TR-YOP-2026-00012
  fromSiteId     String
  toSiteId       String
  status         StockTransferStatus @default(DRAFT)
  shippedAt      DateTime?
  receivedAt     DateTime?
  notes          String?
  createdById    String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization   Organization        @relation(fields: [organizationId], references: [id])
  fromSite       Site                @relation("StockTransferFrom", fields: [fromSiteId], references: [id])
  toSite         Site                @relation("StockTransferTo", fields: [toSiteId], references: [id])
  createdBy      Membership?         @relation("StockTransferCreatedBy", fields: [createdById], references: [id])
  lines          StockTransferLine[]
  stockMovements StockMovement[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([fromSiteId])
  @@index([toSiteId])
}

enum StockTransferStatus {
  DRAFT
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

model StockTransferLine {
  id              String @id @default(cuid(2))
  organizationId  String
  stockTransferId String
  productId       String
  quantity        Int // unités de base
  receivedQty     Int    @default(0)

  organization  Organization  @relation(fields: [organizationId], references: [id])
  stockTransfer StockTransfer @relation(fields: [stockTransferId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])

  @@index([organizationId, stockTransferId])
  @@index([productId])
}

model PurchaseOrderLine {
  id              String @id @default(cuid(2))
  organizationId  String
  purchaseOrderId String
  productId       String
  quantity        Int
  receivedQty     Int    @default(0)
  unitCost        Int
  receivedCost    Int? // M07 §14 — dernier coût réel reçu (écart de prix)

  organization  Organization  @relation(fields: [organizationId], references: [id])
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])

  @@index([organizationId, purchaseOrderId])
  @@index([productId])
}

// ═══════════════════════════════════════════════════════════════
// Facturation, paiements, caisse
// ═══════════════════════════════════════════════════════════════

model Invoice {
  id                String        @id @default(cuid(2))
  organizationId    String
  siteId            String
  number            String? // attribué à l'émission : FAC-2026-000123 (sans trou)
  type              InvoiceType   @default(INVOICE)
  status            InvoiceStatus @default(DRAFT)
  customerId        String
  vehicleId         String?
  repairOrderId     String?
  quoteId           String?
  creditedInvoiceId String? // pour un avoir
  billTo            Payer         @default(CUSTOMER) // facture client ou facture assurance
  insuranceClaimId  String?
  issuedAt          DateTime?
  dueDate           DateTime?     @db.Date
  subtotal          Int           @default(0)
  discountTotal     Int           @default(0)
  vatTotal          Int           @default(0)
  total             Int           @default(0)
  amountPaid        Int           @default(0)
  balance           Int           @default(0) // total - amountPaid (dénormalisé, maintenu en transaction)
  mileage           Int?
  notes             String?
  publicToken       String?       @unique
  // FNE
  fneStatus         FneStatus     @default(NOT_REQUIRED)
  fneNumber         String?
  fneQrCode         String?
  fneCertifiedAt    DateTime?
  fneError          String?
  fneRaw            Json?
  voidedAt          DateTime?
  voidReason        String?
  origin            RecordOrigin  @default(NATIVE)
  externalNumber    String? // RG-M13-20 : n° dans le logiciel source (import), utilisé dans {{facture.numero}}
  createdById       String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  // M09 §14
  writtenOffAmount  Int?
  writtenOffAt      DateTime?
  writtenOffById    String?
  writeOffReason    String?
  disputedAt        DateTime?
  collectionCaseId  String?
  // M08 §14
  creditedAmount    Int           @default(0) // Σ |total| des avoirs émis sur cette facture
  costTotal         Int           @default(0) // coût pièces + MO (marge, M12), figé à l'émission
  fneAttempts       Int           @default(0)
  fneNextRetryAt    DateTime?
  fneErrorKind      String? // transient | rejected
  sentAt            DateTime?

  organization    Organization        @relation(fields: [organizationId], references: [id])
  site            Site                @relation(fields: [siteId], references: [id])
  collectionCase  CollectionCase?     @relation(fields: [collectionCaseId], references: [id])
  customer        Customer            @relation(fields: [customerId], references: [id])
  vehicle         Vehicle?            @relation(fields: [vehicleId], references: [id])
  repairOrder     RepairOrder?        @relation(fields: [repairOrderId], references: [id])
  quote           Quote?              @relation(fields: [quoteId], references: [id])
  creditedInvoice Invoice?            @relation("InvoiceCreditNote", fields: [creditedInvoiceId], references: [id])
  creditNotes     Invoice[]           @relation("InvoiceCreditNote")
  insuranceClaim  InsuranceClaim?     @relation(fields: [insuranceClaimId], references: [id])
  createdBy       Membership?         @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  lines           InvoiceLine[]
  depositLines    InvoiceLine[]       @relation("InvoiceLineDeposit") // lignes de déduction de cet acompte
  allocations     PaymentAllocation[]
  paymentLinks    PaymentLink[]
  reminders       Reminder[]

  @@unique([organizationId, number])
  @@index([organizationId, status, dueDate])
  @@index([organizationId, customerId, status])
  @@index([fneStatus, fneNextRetryAt]) // fne.retry (RG-M08-15)
  @@index([organizationId, issuedAt]) // M12 : agrégats CA par période (RG-M12-05)
}

enum InvoiceType {
  INVOICE
  CREDIT_NOTE
  DEPOSIT
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
  WRITTEN_OFF
  DISPUTED
}

enum FneStatus {
  NOT_REQUIRED
  PENDING
  CERTIFIED
  FAILED
  MANUAL
}

model InvoiceLine {
  id                String   @id @default(cuid(2))
  organizationId    String
  invoiceId         String
  type              LineType
  productId         String?
  laborOperationId  String?
  description       String
  quantity          Float
  unitPrice         Int
  discountRate      Int      @default(0)
  vatRate           Int
  lineSubtotal      Int // calculé et figé à l'émission
  lineVat           Int
  lineTotal         Int
  sortOrder         Int      @default(0)
  // M08 §14
  costAmount        Int      @default(0) // CMP × qté (pièces) ou coût MO, figé à l'émission
  depositInvoiceId  String? // ligne de déduction d'acompte
  payer             Payer    @default(CUSTOMER)
  repairOrderLineId String?

  organization   Organization    @relation(fields: [organizationId], references: [id])
  invoice        Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  depositInvoice Invoice?        @relation("InvoiceLineDeposit", fields: [depositInvoiceId], references: [id])
  product        Product?        @relation(fields: [productId], references: [id])
  laborOperation LaborOperation? @relation(fields: [laborOperationId], references: [id])

  @@index([organizationId, invoiceId])
  @@index([organizationId, depositInvoiceId])
}

model Payment {
  id             String        @id @default(cuid(2))
  organizationId String
  siteId         String
  customerId     String?
  number         String // REC-2026-000310 (reçu)
  method         PaymentMethod
  amount         Int
  receivedAt     DateTime
  reference      String? // ID transaction Wave/OM, n° chèque
  status         PaymentStatus @default(CONFIRMED)
  provider       String? // cinetpay | wave | manual
  providerRef    String?
  cashSessionId  String?
  receivedById   String?
  unallocated    Int           @default(0) // acompte / trop-perçu
  notes          String?
  origin         RecordOrigin  @default(NATIVE)
  createdAt      DateTime      @default(now())
  // M08 §14
  voidedAt       DateTime?
  voidReason     String?
  payerPhone     String? // numéro mobile money payeur (rapprochement)

  organization Organization        @relation(fields: [organizationId], references: [id])
  site         Site                @relation(fields: [siteId], references: [id])
  customer     Customer?           @relation(fields: [customerId], references: [id])
  cashSession  CashSession?        @relation(fields: [cashSessionId], references: [id])
  receivedBy   Membership?         @relation("PaymentReceivedBy", fields: [receivedById], references: [id])
  allocations  PaymentAllocation[]
  paymentLinks PaymentLink[]
  refunds      Refund[]

  @@unique([organizationId, number])
  @@unique([provider, providerRef])
  @@index([organizationId, method, reference])
  @@index([organizationId, receivedAt]) // M12 : encaissements par période (RG-M12-20)
}

enum PaymentMethod {
  CASH
  WAVE
  ORANGE_MONEY
  MTN_MOMO
  MOOV_MONEY
  CARD
  BANK_TRANSFER
  CHEQUE
  INSURANCE
  OTHER
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
}

model PaymentAllocation {
  id               String    @id @default(cuid(2))
  organizationId   String
  paymentId        String? // M08 §14 : null pour l'affectation d'un crédit client
  invoiceId        String
  amount           Int
  // M08 §14
  customerCreditId String? // affectation d'un crédit client (avoir payé, trop-perçu)
  voidedAt         DateTime? // paiement annulé / chèque rejeté : l'affectation ne compte plus

  organization   Organization        @relation(fields: [organizationId], references: [id])
  payment        Payment?            @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice        Invoice             @relation(fields: [invoiceId], references: [id])
  customerCredit CustomerCredit?     @relation(fields: [customerCreditId], references: [id])
  attribution    PaymentAttribution?

  @@index([organizationId, paymentId])
  @@index([organizationId, invoiceId])
}

model PaymentLink {
  id              String         @id @default(cuid(2))
  organizationId  String
  invoiceId       String
  provider        String
  providerRef     String
  url             String
  amount          Int
  status          PaymentStatus  @default(PENDING)
  expiresAt       DateTime
  paymentId       String?
  createdAt       DateTime       @default(now())
  // M08 hors §14 (étape 4.3, RG-M08-23..25) : moyen choisi, cycle de vie et rapprochement
  method          PaymentMethod? // moyen choisi sur le portail (null = au choix du client)
  createdById     String? // null = portail client
  confirmedAt     DateTime?
  confirmedAmount Int? // montant confirmé par getStatus (peut différer de amount)
  closedAt        DateTime?
  closeReason     String? // replaced | cancelled | expired | failed
  lastCheckedAt   DateTime?
  updatedAt       DateTime       @default(now()) @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  invoice      Invoice      @relation(fields: [invoiceId], references: [id])
  payment      Payment?     @relation(fields: [paymentId], references: [id])
  createdBy    Membership?  @relation("PaymentLinkCreatedBy", fields: [createdById], references: [id])

  @@unique([provider, providerRef])
  @@index([organizationId, invoiceId])
  @@index([status, expiresAt]) // payments.reconcile, paymentLinks.expire
}

model CashSession {
  // ouverture / clôture de caisse
  id             String    @id @default(cuid(2))
  organizationId String
  siteId         String
  openedById     String
  openedAt       DateTime
  openingFloat   Int
  closedById     String?
  closedAt       DateTime?
  expectedCash   Int?
  countedCash    Int?
  difference     Int?
  notes          String?
  // M08 §14
  denominations  Json? // { "10000": 42, "5000": 30, … }
  lateClose      Boolean   @default(false)
  reviewedById   String?
  reviewedAt     DateTime?
  reviewComment  String? // M08 (hors §14) : commentaire de validation de l'écart (cash.review)

  organization Organization @relation(fields: [organizationId], references: [id])
  site         Site         @relation(fields: [siteId], references: [id])
  openedBy     Membership   @relation("CashSessionOpenedBy", fields: [openedById], references: [id])
  closedBy     Membership?  @relation("CashSessionClosedBy", fields: [closedById], references: [id])
  reviewedBy   Membership?  @relation("CashSessionReviewedBy", fields: [reviewedById], references: [id])
  payments     Payment[]
  expenses     Expense[]
  drops        CashDrop[]
  refunds      Refund[]

  @@index([organizationId, siteId])
  @@index([organizationId, siteId, closedAt])
}

model Expense {
  // décaissements de caisse (petites dépenses)
  id             String    @id @default(cuid(2))
  organizationId String
  siteId         String
  cashSessionId  String?
  category       String
  amount         Int
  description    String
  paidAt         DateTime
  createdById    String?
  // M08 (hors §14) : justificatif (US-M08-12) et validation au-delà du seuil (RG-M08-30)
  attachmentId   String?
  approvedById   String?
  approvedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  site         Site         @relation(fields: [siteId], references: [id])
  cashSession  CashSession? @relation(fields: [cashSessionId], references: [id])
  createdBy    Membership?  @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  approvedBy   Membership?  @relation("ExpenseApprovedBy", fields: [approvedById], references: [id])

  @@index([organizationId, siteId])
}

model CashDrop {
  // M08 §14 — versement coffre / banque depuis la caisse (RG-M08-28)
  id             String   @id @default(cuid(2))
  organizationId String
  siteId         String
  cashSessionId  String
  amount         Int
  destination    String // safe | bank
  reference      String?
  createdById    String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  site         Site         @relation(fields: [siteId], references: [id])
  cashSession  CashSession  @relation(fields: [cashSessionId], references: [id])
  createdBy    Membership?  @relation("CashDropCreatedBy", fields: [createdById], references: [id])

  @@index([organizationId, cashSessionId])
}

model Refund {
  // M08 §14 — remboursement d'un trop-perçu ou d'un avoir payé (RG-M08-22)
  id               String        @id @default(cuid(2))
  organizationId   String
  siteId           String
  customerId       String
  paymentId        String?
  customerCreditId String?
  method           PaymentMethod
  amount           Int
  reference        String?
  cashSessionId    String?
  reason           String
  createdById      String?
  createdAt        DateTime      @default(now())

  organization   Organization    @relation(fields: [organizationId], references: [id])
  site           Site            @relation(fields: [siteId], references: [id])
  customer       Customer        @relation(fields: [customerId], references: [id])
  payment        Payment?        @relation(fields: [paymentId], references: [id])
  customerCredit CustomerCredit? @relation(fields: [customerCreditId], references: [id])
  cashSession    CashSession?    @relation(fields: [cashSessionId], references: [id])
  createdBy      Membership?     @relation("RefundCreatedBy", fields: [createdById], references: [id])

  @@index([organizationId, customerId])
  @@index([organizationId, cashSessionId])
  @@index([organizationId, createdAt]) // M12 : remboursements en négatif (RG-M12-20)
}

model CustomerCredit {
  // M08 §14 — crédit client issu d'un trop-perçu ou d'un avoir payé (RG-M08-12)
  id             String   @id @default(cuid(2))
  organizationId String
  customerId     String
  sourceType     String // payment | credit_note
  sourceId       String
  amount         Int
  remaining      Int
  createdAt      DateTime @default(now())

  organization Organization        @relation(fields: [organizationId], references: [id])
  customer     Customer            @relation(fields: [customerId], references: [id])
  allocations  PaymentAllocation[]
  refunds      Refund[]

  @@index([organizationId, customerId])
}

model PaymentWebhookLog {
  // M08 §14 — journal des webhooks de paiement (RG-M08-24, étape 4.3)
  id             String   @id @default(cuid(2))
  organizationId String?
  provider       String
  providerRef    String?
  signatureValid Boolean
  payload        Json
  outcome        String // created | duplicate | rejected | error
  receivedAt     DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([provider, providerRef])
}

// ═══════════════════════════════════════════════════════════════
// Créances et recouvrement
// ═══════════════════════════════════════════════════════════════

model CollectionCase {
  // un dossier par client ayant un solde en retard
  id                      String            @id @default(cuid(2))
  organizationId          String
  customerId              String
  status                  CollectionStatus  @default(OPEN)
  stage                   Int               @default(0) // palier atteint dans la séquence
  assignedToId            String?
  totalDue                Int               @default(0)
  oldestDueDate           DateTime?         @db.Date
  nextActionAt            DateTime?
  pausedUntil             DateTime?
  closedAt                DateTime?
  closeReason             String?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  // M09 §14
  anchorDate              DateTime?         @db.Date // plus ancienne échéance en retard à l'ouverture (ancre M10)
  overdueDue              Int               @default(0) // part échue de totalDue
  maxDaysOverdue          Int               @default(0)
  escalatedAt             DateTime?
  disputeOpenedAt         DateTime?
  disputeReason           String?
  disputedAmount          Int?
  formalNoticeAt          DateTime?
  formalNoticeDeliveredAt DateTime?
  formalNoticeMethod      String? // email | whatsapp | hand | bailiff
  lastContactAt           DateTime?
  brokenPromiseCount      Int               @default(0)
  unreachableCount        Int               @default(0) // appels « pas de réponse » consécutifs
  previousStatus          CollectionStatus? // restauré à la fin d'une pause

  organization Organization     @relation(fields: [organizationId], references: [id])
  customer     Customer         @relation(fields: [customerId], references: [id])
  assignedTo   Membership?      @relation("CollectionCaseAssignee", fields: [assignedToId], references: [id])
  promises     PaymentPromise[]
  notes        CollectionNote[]
  invoices     Invoice[]

  @@index([organizationId, status])
  @@index([organizationId, customerId])
}

enum CollectionStatus {
  OPEN
  PROMISED
  PAUSED
  DISPUTED
  ESCALATED
  CLOSED_PAID
  CLOSED_WRITTEN_OFF
}

model PaymentPromise {
  id               String        @id @default(cuid(2))
  organizationId   String
  collectionCaseId String
  amount           Int
  promisedDate     DateTime      @db.Date
  channel          String? // téléphone, WhatsApp, en personne
  status           PromiseStatus @default(PENDING)
  createdById      String?
  createdAt        DateTime      @default(now())
  // M09 §14 (organizationId déjà présent, A §3)
  paidAmount       Int           @default(0)
  evaluatedAt      DateTime?
  reminderId       String? // relance à l'origine de la promesse (attribution)
  cancelledReason  String?

  organization   Organization   @relation(fields: [organizationId], references: [id])
  collectionCase CollectionCase @relation(fields: [collectionCaseId], references: [id], onDelete: Cascade)
  createdBy      Membership?    @relation("PaymentPromiseCreatedBy", fields: [createdById], references: [id])

  @@index([organizationId, collectionCaseId])
}

enum PromiseStatus {
  PENDING
  KEPT
  PARTIALLY_KEPT
  BROKEN
  CANCELLED
}

model CollectionNote {
  id               String       @id @default(cuid(2))
  organizationId   String
  collectionCaseId String
  body             String
  type             String       @default("note") // note | call | visit
  callOutcome      CallOutcome? // M09 §14
  callbackAt       DateTime? // M09 §14
  createdById      String?
  createdAt        DateTime     @default(now())

  organization   Organization   @relation(fields: [organizationId], references: [id])
  collectionCase CollectionCase @relation(fields: [collectionCaseId], references: [id], onDelete: Cascade)
  createdBy      Membership?    @relation("CollectionNoteCreatedBy", fields: [createdById], references: [id])

  @@index([organizationId, collectionCaseId])
}

enum CallOutcome {
  REACHED
  NO_ANSWER
  WRONG_NUMBER
  CALLBACK
}

model CreditOverride {
  // M09 §14, RG-M09-10 : dérogation de crédit pour un OR
  id             String    @id @default(cuid(2))
  organizationId String
  customerId     String
  repairOrderId  String?
  requestedById  String
  decidedById    String?
  status         String    @default("PENDING") // PENDING | GRANTED | REFUSED
  reason         String
  decisionReason String?
  createdAt      DateTime  @default(now())
  decidedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  customer     Customer     @relation(fields: [customerId], references: [id])

  @@index([organizationId, customerId])
}

model PaymentAttribution {
  // M09 §14, RG-M09-14 / A10
  id                  String   @id @default(cuid(2))
  organizationId      String
  paymentAllocationId String   @unique
  source              String // reminder | call | spontaneous
  reminderId          String?
  collectionNoteId    String?
  amount              Int
  createdAt           DateTime @default(now())

  organization      Organization      @relation(fields: [organizationId], references: [id])
  paymentAllocation PaymentAllocation @relation(fields: [paymentAllocationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

model ReceivableSnapshot {
  // M09 §14 : photo quotidienne de la balance âgée pour les courbes M12
  id             String   @id @default(cuid(2))
  organizationId String
  siteId         String?
  date           DateTime @db.Date
  notDue         Int
  b0_30          Int
  b31_60         Int
  b61_90         Int
  b90p           Int

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, siteId, date])
}

// ═══════════════════════════════════════════════════════════════
// Relances et messages
// ═══════════════════════════════════════════════════════════════

model ReminderRule {
  id             String       @id @default(cuid(2))
  organizationId String
  type           ReminderType
  name           String
  isActive       Boolean      @default(true)
  steps          Json // [{ key:"J-30", offsetDays:-30, templateKey:"vt_j30", autoSend:true, channels:["WHATSAPP","SMS"] }, ...]
  sendWindow     Json // { days:[1,2,3,4,5,6], from:"08:00", to:"19:00" }
  conditions     Json         @default("{}") // { customerTypes:["INDIVIDUAL"], minAmount:5000, tags:[] }
  stopOn         String[] // ["appointment.created","payment.received","quote.accepted"]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  reminders    Reminder[]

  @@index([organizationId, type])
}

enum ReminderType {
  INSPECTION
  SERVICE
  RECEIVABLE
  APPOINTMENT
  QUOTE_FOLLOWUP
  VEHICLE_READY
  INSURANCE_EXPIRY
  SATISFACTION
  RECOMMENDED_WORK
  CUSTOM
}

model Reminder {
  // une occurrence planifiée
  id                   String           @id @default(cuid(2))
  organizationId       String
  ruleId               String
  type                 ReminderType
  stepKey              String // "J-30"
  customerId           String
  vehicleId            String?
  invoiceId            String?
  appointmentId        String?
  quoteId              String?
  dueDate              DateTime         @db.Date // échéance de référence (expiration VT, échéance facture…)
  scheduledFor         DateTime // quand l'envoyer
  status               ReminderStatus   @default(PLANNED)
  channel              Channel?
  renderedBody         String?
  approvedById         String?
  approvedAt           DateTime?
  sentAt               DateTime?
  skippedReason        String?
  snoozedUntil         DateTime?
  outcome              ReminderOutcome?
  outcomeAt            DateTime?
  dedupeKey            String // ex. "INSPECTION:veh_123:2026-11-02:J-30"
  // M10 §14 — regroupement, priorisation et traçabilité d'envoi (repris dès la Phase 0, cf. 04 §3)
  sequenceKey          String? // "INSPECTION:veh_123:2026-11-02" (sans le palier)
  groupKey             String? // regroupement d'envoi (RG-M10-15)
  messageId            String? // message M11 portant cette relance (partagé dans un groupe)
  priority             Int              @default(5) // RG-M10-16
  renderedSubject      String?
  editedBody           Boolean          @default(false)
  editedById           String?
  editedContext        Json?
  supersededById       String?
  approvalExpiresAt    DateTime?
  deferCount           Int              @default(0) // reports anti-spam
  isCatchUp            Boolean          @default(false)
  attributedAmount     Int? // FCFA récupérés (créances)
  attributedRevenue    Int? // CA de l'OR issu de la relance (VT, révision)
  // M17 §14 — meilleur moment d'envoi (RG-M17-16)
  timeOptimized        Boolean          @default(false)
  originalScheduledFor DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  organization          Organization  @relation(fields: [organizationId], references: [id])
  rule                  ReminderRule  @relation(fields: [ruleId], references: [id])
  customer              Customer      @relation(fields: [customerId], references: [id])
  vehicle               Vehicle?      @relation(fields: [vehicleId], references: [id])
  invoice               Invoice?      @relation(fields: [invoiceId], references: [id])
  quote                 Quote?        @relation(fields: [quoteId], references: [id])
  approvedBy            Membership?   @relation("ReminderApprovedBy", fields: [approvedById], references: [id])
  editedBy              Membership?   @relation("ReminderEditedBy", fields: [editedById], references: [id])
  supersededBy          Reminder?     @relation("ReminderSupersede", fields: [supersededById], references: [id])
  supersedes            Reminder[]    @relation("ReminderSupersede")
  appointment           Appointment?  @relation("ReminderAppointment", fields: [appointmentId], references: [id])
  triggeredAppointments Appointment[] @relation("AppointmentReminder")
  message               Message?      @relation("ReminderPrimaryMessage", fields: [messageId], references: [id])
  messages              Message[]     @relation("ReminderMessages")
  portalTokens          PortalToken[]

  @@unique([organizationId, dedupeKey])
  @@index([organizationId, status, scheduledFor])
  @@index([organizationId, sequenceKey])
  @@index([organizationId, customerId, status])
  @@index([organizationId, groupKey])
  @@index([organizationId, sentAt]) // M12 : rapport « Performances des relances »
}

enum ReminderStatus {
  PLANNED
  NEEDS_APPROVAL
  QUEUED
  SENT
  FAILED
  SKIPPED
  SNOOZED
  CANCELLED
}

enum ReminderOutcome {
  APPOINTMENT_BOOKED
  PAID
  PARTIALLY_PAID
  PROMISED
  REPLIED
  NO_RESPONSE
  OPTED_OUT
  VISITED
  QUOTE_ACCEPTED
  VEHICLE_PICKED_UP
}

model ReminderSuppression {
  id             String        @id @default(cuid(2))
  organizationId String
  sequenceKey    String?
  customerId     String?
  vehicleId      String?
  type           ReminderType?
  until          DateTime? // null = permanente
  reason         String // "RDV pris le 24/10/2026", "VT effectuée", "Litige"
  source         String // appointment | inspection_done | staff | collection
  createdById    String?
  createdAt      DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  createdBy    Membership?  @relation("ReminderSuppressionCreatedBy", fields: [createdById], references: [id])

  @@index([organizationId, sequenceKey])
  @@index([organizationId, customerId, type])
  @@index([organizationId, vehicleId, type])
}

model MessageTemplate {
  id                     String        @id @default(cuid(2))
  organizationId         String
  key                    String // "vt_j30"
  name                   String
  channel                Channel
  subject                String? // email
  body                   String // avec variables {{client.prenom}}
  whatsappTemplateName   String? // nom du modèle approuvé chez Meta
  whatsappLanguage       String?       @default("fr")
  whatsappStatus         String? // APPROVED | PENDING | REJECTED
  isActive               Boolean       @default(true)
  // M11 §14
  type                   ReminderType? // classement dans l'éditeur
  isTransactional        Boolean       @default(false)
  whatsappCategory       String? // UTILITY | MARKETING | AUTHENTICATION (effective)
  whatsappParamMap       Json? // ["client.salutation","vehicule.marque",…]
  whatsappRejectedReason String?
  whatsappVersion        Int           @default(1)
  isDefault              Boolean       @default(true) // modèle livré non modifié
  updatedAt              DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, key, channel])
}

model QuickReply {
  // réponse rapide partagée dans l'organisation (M11 §14, RG-M11-22)
  id             String  @id @default(cuid(2))
  organizationId String
  title          String
  shortcut       String // "/prix-vidange"
  body           String
  templateKey    String? // modèle approuvé équivalent (hors fenêtre 24 h)
  createdById    String?

  organization Organization @relation(fields: [organizationId], references: [id])
  createdBy    Membership?  @relation("QuickReplyCreatedBy", fields: [createdById], references: [id])

  @@unique([organizationId, shortcut])
}

model Conversation {
  id                      String             @id @default(cuid(2))
  organizationId          String
  customerId              String?
  channel                 Channel
  externalAddress         String // téléphone ou email
  status                  ConversationStatus @default(OPEN)
  assignedToId            String?
  lastMessageAt           DateTime
  unreadCount             Int                @default(0)
  lastIntent              String? // classé par l'IA (M17)
  // M11 §14
  whatsappWindowExpiresAt DateTime?
  lastInboundAt           DateTime?
  candidateCustomerIds    String[] // numéro partagé, à trancher
  createdAt               DateTime           @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  customer     Customer?    @relation(fields: [customerId], references: [id])
  assignedTo   Membership?  @relation("ConversationAssignee", fields: [assignedToId], references: [id])
  messages     Message[]

  @@unique([organizationId, channel, externalAddress])
}

enum ConversationStatus {
  OPEN
  PENDING
  CLOSED
}

model Message {
  id                   String        @id @default(cuid(2))
  organizationId       String
  conversationId       String?
  customerId           String?
  reminderId           String?
  direction            Direction
  channel              Channel
  to                   String
  from                 String?
  subject              String?
  body                 String
  attachments          Json          @default("[]")
  status               MessageStatus @default(QUEUED)
  provider             String
  providerMessageId    String?
  errorCode            String?
  errorMessage         String?
  cost                 Int? // FCFA
  fallbackOfId         String? // message d'origine si repli (WhatsApp → SMS)
  idempotencyKey       String? // M11 §14 : unique par organisation/canal
  sentById             String? // null = automatique
  // M11 §14
  kind                 MessageKind   @default(REMINDER)
  templateKey          String?
  whatsappTemplateName String? // modèle Meta réellement utilisé
  intent               String? // classement M17 (entrants)
  intentConfidence     Float?
  attemptCount         Int           @default(0)
  nextRetryAt          DateTime?
  failedAt             DateTime?
  createdAt            DateTime      @default(now())
  sentAt               DateTime?
  deliveredAt          DateTime?
  readAt               DateTime?

  organization        Organization         @relation(fields: [organizationId], references: [id])
  conversation        Conversation?        @relation(fields: [conversationId], references: [id])
  customer            Customer?            @relation(fields: [customerId], references: [id])
  reminder            Reminder?            @relation("ReminderMessages", fields: [reminderId], references: [id])
  primaryForReminders Reminder[]           @relation("ReminderPrimaryMessage")
  fallbackOf          Message?             @relation("MessageFallback", fields: [fallbackOfId], references: [id])
  fallbacks           Message[]            @relation("MessageFallback")
  sentBy              Membership?          @relation("MessageSentBy", fields: [sentById], references: [id])
  statusEvents        MessageStatusEvent[]
  attempts            MessageAttempt[]

  @@unique([organizationId, idempotencyKey, channel])
  @@index([organizationId, providerMessageId])
  @@index([organizationId, customerId, createdAt])
  @@index([organizationId, status, createdAt])
}

enum Direction {
  OUTBOUND
  INBOUND
}

enum MessageKind {
  REMINDER
  TRANSACTIONAL
  CONVERSATION
  DIGEST
  SYSTEM
}

enum MessageStatus {
  QUEUED
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
  RECEIVED
}

model MessageStatusEvent {
  // idempotence des webhooks de statut (M11 §14)
  id                String        @id @default(cuid(2))
  organizationId    String
  messageId         String
  providerMessageId String
  status            MessageStatus
  occurredAt        DateTime

  organization Organization @relation(fields: [organizationId], references: [id])
  message      Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([providerMessageId, status])
  @@index([organizationId, messageId])
}

model MessageAttempt {
  // une tentative d'envoi fournisseur (M11 §14, RG-M11-07)
  id             String    @id @default(cuid(2))
  organizationId String
  messageId      String
  attempt        Int
  startedAt      DateTime
  finishedAt     DateTime?
  outcome        String // OK | TEMPORARY | PERMANENT_RECIPIENT | PERMANENT_TEMPLATE | PERMANENT_CONFIG | RATE_LIMIT
  providerCode   String?
  providerRaw    Json?

  organization Organization @relation(fields: [organizationId], references: [id])
  message      Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([organizationId, messageId])
}

model ChannelConfig {
  id                 String    @id @default(cuid(2))
  organizationId     String
  channel            Channel
  provider           String // whatsapp_cloud | wa_link | orange_sms | twilio | http_sms | smtp | resend | console
  isActive           Boolean   @default(false)
  priority           Int       @default(1)
  credentials        String // JSON chiffré (AES-256-GCM)
  senderId           String? // nom d'expéditeur SMS, numéro WhatsApp, email from
  status             String? // OK | ERROR
  lastCheckedAt      DateTime?
  balance            Int? // crédit SMS restant si disponible
  // M11 §14
  webhookVerifyToken String?
  messagingTier      String? // palier de messagerie WhatsApp
  lastError          String?

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, channel, provider])
}

model OptOut {
  id             String   @id @default(cuid(2))
  organizationId String
  address        String // téléphone ou email
  channel        Channel?
  reason         String?
  createdAt      DateTime @default(now())
  // M11 §14
  source         String? // keyword | email_link | staff | complaint
  messageId      String?

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, address, channel])
}

// ═══════════════════════════════════════════════════════════════
// Paramètres fournisseurs paiement / FNE
// ═══════════════════════════════════════════════════════════════

model PaymentProviderConfig {
  id             String          @id @default(cuid(2))
  organizationId String
  provider       String // cinetpay | wave
  isActive       Boolean         @default(false)
  credentials    String // chiffré
  methods        PaymentMethod[]
  // M15 RG-M15-17 hors §14 (étape 4.3) : résultat du dernier test
  lastTestedAt   DateTime?
  lastTestOk     Boolean?
  lastError      String?
  updatedAt      DateTime        @default(now()) @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, provider])
}

model FneConfig {
  id              String    @id @default(cuid(2))
  organizationId  String    @unique
  mode            String    @default("manual") // api | manual | disabled
  credentials     String? // chiffré
  establishmentId String?
  pointOfSale     String?
  isActive        Boolean   @default(false)
  // M08 étape 4.2 (hors §14) : adaptateur du mode api et résultat du dernier test (RG-M15-18).
  provider        String    @default("dgi_api") // dgi_api | fake (simulateur, hors production)
  lastTestedAt    DateTime?
  lastTestOk      Boolean?
  lastError       String?
  updatedAt       DateTime  @default(now()) @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
}

// ═══════════════════════════════════════════════════════════════
// Import / synchronisation
// ═══════════════════════════════════════════════════════════════

model DataSource {
  id             String         @id @default(cuid(2))
  organizationId String
  type           DataSourceType
  name           String
  config         String // JSON chiffré : chemin, connexion SQL, requêtes, mapping
  mapping        Json           @default("{}")
  schedule       String? // cron
  isActive       Boolean        @default(true)
  lastRunAt      DateTime?
  lastStatus     String?

  organization Organization  @relation(fields: [organizationId], references: [id])
  importJobs   ImportJob[]
  externalRefs ExternalRef[]

  @@index([organizationId])
}

enum DataSourceType {
  FILE_UPLOAD
  WATCHED_FOLDER
  SQL_DATABASE
  REST_API
  WEBHOOK
}

model ImportJob {
  id              String       @id @default(cuid(2))
  organizationId  String
  dataSourceId    String?
  entity          String // customers | vehicles | invoices | payments | products | repair_orders | mixed
  fileUrl         String?
  fileName        String?
  encoding        String? // UTF-8 | UTF-8-BOM | UTF-16 | WINDOWS-1252 | ISO-8859-1 (RG-M13-02)
  delimiter       String? // ; , \t | (RG-M13-03, CSV uniquement)
  headerSignature String? // sha256 des en-têtes normalisés triés (RG-M13-08)
  mapping         Json         @default("{}") // { columns: {...}, options: {...} } (imports.setMapping)
  policy          ImportPolicy @default(UPSERT)
  status          ImportStatus @default(PENDING)
  dryRun          Boolean      @default(false)
  totalRows       Int          @default(0)
  processedRows   Int          @default(0)
  createdCount    Int          @default(0)
  updatedCount    Int          @default(0)
  unchangedCount  Int          @default(0)
  skippedCount    Int          @default(0)
  errorCount      Int          @default(0)
  warningCount    Int          @default(0)
  summary         Json? // échantillon avant/après de la simulation (imports.simulate)
  errorReportUrl  String? // clé S3 du rapport d'erreurs .xlsx
  startedAt       DateTime?
  finishedAt      DateTime?
  rolledBackAt    DateTime?
  createdById     String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id])
  dataSource   DataSource?      @relation(fields: [dataSourceId], references: [id])
  createdBy    Membership?      @relation("ImportJobCreatedBy", fields: [createdById], references: [id])
  errors       ImportRowError[]

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
}

enum ImportPolicy {
  CREATE_ONLY
  UPSERT
  UPSERT_OVERWRITE
}

enum ImportStatus {
  PENDING
  VALIDATING
  READY
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  ROLLED_BACK
}

model ImportRowError {
  id             String  @id @default(cuid(2))
  organizationId String
  importJobId    String
  rowNumber      Int
  field          String?
  message        String
  severity       String  @default("ERROR") // ERROR | WARNING (RG-M13-16)
  raw            Json

  organization Organization @relation(fields: [organizationId], references: [id])
  importJob    ImportJob    @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@index([organizationId, importJobId])
}

model ExternalRef {
  // lien entre un enregistrement et son ID dans le logiciel source
  id             String    @id @default(cuid(2))
  organizationId String
  dataSourceId   String
  entity         String
  externalId     String
  internalId     String
  hash           String? // détection des changements
  importJobId    String? // dernier job ayant écrit (rollback)
  lastSeenAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  dataSource   DataSource   @relation(fields: [dataSourceId], references: [id])

  @@unique([dataSourceId, entity, externalId])
  @@index([organizationId])
}

model ApiKey {
  id             String    @id @default(cuid(2))
  organizationId String
  name           String
  keyHash        String    @unique
  prefix         String // affiché : "ak_live_3f9a…"
  scopes         String[]
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model WebhookEndpoint {
  // webhooks sortants vers d'autres systèmes
  id             String   @id @default(cuid(2))
  organizationId String
  url            String
  secret         String
  events         String[]
  isActive       Boolean  @default(true)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

// ═══════════════════════════════════════════════════════════════
// Assurances
// ═══════════════════════════════════════════════════════════════

model InsuranceCompany {
  id                String   @id @default(cuid(2))
  organizationId    String
  name              String
  phone             String?
  email             String?
  paymentTermsDays  Int      @default(60)
  // M16 §14
  customerId        String?  @unique // Customer COMPANY utilisé pour facturer la compagnie (RG-M16-01)
  legalName         String?
  ncc               String?
  rccm              String?
  address           String?
  claimsContactName String?
  claimsPhone       String? // E.164
  claimsEmail       String?
  accountingEmail   String?
  laborRate         Int? // taux horaire MO convenu (FCFA HT)
  partsDiscountRate Int? // remise pièces convenue (%)
  requiredDocuments String[] // kinds d'Attachment exigés (RG-M16-09)
  followUpConfig    Json     @default("{}") // { approval:[7,14,21], payment:[0,15,30], repeatEvery:30 }
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id])
  customer     Customer?        @relation("InsurerCustomer", fields: [customerId], references: [id])
  vehicles     Vehicle[]
  claims       InsuranceClaim[]

  @@index([organizationId])
}

model InsuranceClaim {
  id                 String      @id @default(cuid(2))
  organizationId     String
  insuranceCompanyId String
  customerId         String
  vehicleId          String
  claimNumber        String?
  policyNumber       String?
  accidentDate       DateTime?   @db.Date
  expertName         String?
  expertVisitAt      DateTime?
  status             ClaimStatus @default(OPENED)
  deductible         Int         @default(0) // franchise client
  approvedAmount     Int?
  notes              String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  // M16 §14 (le lien OR existe déjà : RepairOrder.insuranceClaimId)
  siteId             String?
  number             String // SIN-YOP-2026-00031 (A4 : numérotation par site)
  quoteId            String? // devis assurance retenu
  accidentPlace      String?
  circumstances      String?
  expertFirm         String?
  expertPhone        String?
  expertEmail        String?
  expertVisitedAt    DateTime?
  estimateSentAt     DateTime?
  approvedAt         DateTime?
  approvalRef        String?
  depreciationAmount Int         @default(0) // vétusté TTC à la charge du client
  gapAmount          Int         @default(0) // écart non pris en charge mis à la charge du client
  gapHandling        String? // REVISE | CUSTOMER | GARAGE
  vatPaidBy          Payer       @default(INSURANCE) // INSURANCE ou CUSTOMER (RG-M16-06)
  rejectedAt         DateTime?
  rejectReason       String?
  closedAt           DateTime?
  createdById        String?
  deletedAt          DateTime?

  organization     Organization     @relation(fields: [organizationId], references: [id])
  insuranceCompany InsuranceCompany @relation(fields: [insuranceCompanyId], references: [id])
  customer         Customer         @relation(fields: [customerId], references: [id])
  vehicle          Vehicle          @relation(fields: [vehicleId], references: [id])
  site             Site?            @relation(fields: [siteId], references: [id])
  repairOrders     RepairOrder[]
  invoices         Invoice[]
  activities       ClaimActivity[]
  followUps        ClaimFollowUp[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([organizationId, insuranceCompanyId])
}

enum ClaimStatus {
  OPENED
  EXPERT_SCHEDULED
  ESTIMATE_SENT
  APPROVED
  REPAIRING
  INVOICED
  PARTIALLY_PAID // M16 §14
  PAID
  REJECTED
  CANCELLED // M16 §14
}

model ClaimActivity {
  // M16 §14 — chronologie du dossier sinistre
  id             String    @id @default(cuid(2))
  organizationId String
  claimId        String
  type           String // status_change | call | note | email | whatsapp | visit | followup
  body           String?
  data           Json      @default("{}")
  messageId      String?
  nextActionAt   DateTime?
  createdById    String?
  createdAt      DateTime  @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id])
  claim        InsuranceClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([organizationId, claimId, createdAt])
}

model ClaimFollowUp {
  // M16 §14 — relance planifiée vers l'assureur (RG-M16-08) ; pas un Reminder M10 (A7)
  id             String         @id @default(cuid(2))
  organizationId String
  claimId        String
  invoiceId      String?
  kind           String // approval | payment | expert
  stepKey        String // "J+7", "J+30"
  scheduledFor   DateTime
  status         ReminderStatus @default(PLANNED)
  channel        Channel?
  messageId      String?
  sentAt         DateTime?
  snoozedUntil   DateTime?
  dedupeKey      String
  createdAt      DateTime       @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id])
  claim        InsuranceClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@unique([organizationId, dedupeKey])
  @@index([organizationId, status, scheduledFor])
}

// ═══════════════════════════════════════════════════════════════
// Transverse
// ═══════════════════════════════════════════════════════════════

model Attachment {
  id             String   @id @default(cuid(2))
  organizationId String
  entity         String // repair_order | vehicle | invoice | claim | inspection_item
  entityId       String
  kind           String // photo_checkin | photo_damage | signature | document
  url            String
  mimeType       String
  size           Int
  caption        String?
  createdById    String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  createdBy    Membership?  @relation("AttachmentCreatedBy", fields: [createdById], references: [id])

  @@index([organizationId, entity, entityId])
}

model DocumentSequence {
  id             String  @id @default(cuid(2))
  organizationId String
  siteId         String?
  docType        String // OR | DEV | FAC | AV | REC | BC | INV | TR
  year           Int
  lastValue      Int     @default(0)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, siteId, docType, year])
}

model AuditLog {
  id             String   @id @default(cuid(2))
  organizationId String
  userId         String?
  membershipId   String?
  siteId         String?
  action         String // invoice.void, stock.adjust…
  entity         String
  entityId       String
  before         Json?
  after          Json?
  reason         String?
  ip             String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User?        @relation(fields: [userId], references: [id])

  @@index([organizationId, entity, entityId])
  @@index([organizationId, createdAt])
  @@index([organizationId, action])
}

// ═══════════════════════════════════════════════════════════════
// Authentification (Better Auth), invitations, permissions par rôle
// ═══════════════════════════════════════════════════════════════

model Session {
  id                   String   @id @default(cuid(2))
  userId               String
  token                String   @unique
  expiresAt            DateTime
  ipAddress            String?
  userAgent            String?
  activeOrganizationId String?
  activeSiteId         String? // null = « Tous les sites »
  isPinSession         Boolean  @default(false)
  deviceId             String?
  lastActiveAt         DateTime @default(now())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  // identifiants Better Auth (credential = mot de passe argon2id)
  id         String   @id @default(cuid(2))
  userId     String
  providerId String // "credential"
  accountId  String
  password   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  // OTP et jetons de réinitialisation (Better Auth)
  id         String   @id @default(cuid(2))
  identifier String // "+2250708123456:RESET"
  value      String // code haché
  attempts   Int      @default(0)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([identifier])
}

model TrustedDevice {
  id                     String    @id @default(cuid(2))
  organizationId         String?
  userId                 String? // null si appareil partagé d'atelier
  deviceId               String // identifiant aléatoire stocké en cookie httpOnly
  label                  String? // "Tablette atelier 1"
  isSharedWorkshopDevice Boolean   @default(false)
  siteId                 String?
  expiresAt              DateTime?
  createdAt              DateTime  @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@unique([deviceId])
}

model Invitation {
  id             String           @id @default(cuid(2))
  organizationId String
  name           String
  email          String?
  phone          String? // E.164
  role           Role
  siteIds        String[]
  permissions    String[]
  tokenHash      String           @unique
  channel        Channel?
  status         InvitationStatus @default(PENDING)
  invitedById    String // Membership.id
  expiresAt      DateTime
  acceptedAt     DateTime?
  acceptedUserId String?
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, status])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model RolePermission {
  // Permissions par défaut d'un rôle, surchargées par l'organisation
  id             String   @id @default(cuid(2))
  organizationId String
  role           Role
  permissions    String[]
  updatedById    String?
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, role])
}

model DomainEvent {
  id             String    @id @default(cuid(2))
  organizationId String
  type           String
  payload        Json
  occurredAt     DateTime  @default(now())
  processedAt    DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, type, occurredAt])
}

model Notification {
  // notifications internes de l'application
  id             String    @id @default(cuid(2))
  organizationId String
  membershipId   String
  type           String
  title          String
  body           String?
  link           String?
  readAt         DateTime?
  createdAt      DateTime  @default(now())
  // M12 §14 — alertes (RG-M12-27/28)
  severity       String? // info | warning | critical
  dedupeKey      String? // "alert.channel_error:cc_123:2026-10-18" (une fois par objet et par jour)

  organization Organization @relation(fields: [organizationId], references: [id])
  membership   Membership   @relation(fields: [membershipId], references: [id])

  @@unique([organizationId, membershipId, dedupeKey])
  @@index([organizationId, membershipId, readAt])
}

model AiInteraction {
  // trace des appels IA (coût, qualité)
  id             String   @id @default(cuid(2))
  organizationId String
  feature        String // quote_draft | intent_classification | …
  inputRef       String?
  output         Json
  accepted       Boolean? // l'utilisateur a-t-il gardé la suggestion
  tokensIn       Int?
  tokensOut      Int?
  createdById    String?
  createdAt      DateTime @default(now())
  // M17 §14 — journal (RG-M17-06/07)
  promptVersion  String   @default("v1")
  status         String   @default("OK") // OK | INVALID_OUTPUT | TIMEOUT | ERROR | QUOTA_EXCEEDED | DISABLED
  latencyMs      Int?
  credits        Int      @default(0)
  model          String? // valeur de AI_MODEL utilisée (null = repli sans IA)
  editDistance   Int?

  // M17 : suppression en cascade avec l'organisation (journal technique, jamais supprimé en
  // production — l'organisation y est anonymisée), membre supprimé → auteur effacé.
  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    Membership?    @relation("AiInteractionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  suggestions  AiSuggestion[]

  @@index([organizationId, feature])
  @@index([organizationId, feature, createdAt])
  @@index([organizationId, createdAt])
}

// ═══════════════════════════════════════════════════════════════
// M17 §14 — IA et automatisations
// ═══════════════════════════════════════════════════════════════

model AiSuggestion {
  // proposition IA (ou repli) en attente de décision humaine (RG-M17-02)
  id             String             @id @default(cuid(2))
  organizationId String
  interactionId  String? // AiInteraction (null si repli sans IA)
  feature        String // reply_draft | slot | quote_draft | quote_explanation | extraction | promise | optout | rule_tuning | automation
  targetEntity   String // conversation | repair_order | quote | vehicle | purchase_order | reminder_rule | automation_run
  targetId       String?
  payload        Json
  status         AiSuggestionStatus @default(PENDING)
  isFallback     Boolean            @default(false)
  decidedById    String?
  decidedAt      DateTime?
  expiresAt      DateTime
  createdAt      DateTime           @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  interaction  AiInteraction? @relation(fields: [interactionId], references: [id], onDelete: SetNull)
  decidedBy    Membership?    @relation("AiSuggestionDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([organizationId, targetEntity, targetId, status])
  @@index([organizationId, status, expiresAt])
}

enum AiSuggestionStatus {
  PENDING
  ACCEPTED
  EDITED_ACCEPTED
  DISMISSED
  EXPIRED
}

model AiAssistantThread {
  // assistant conversationnel lecture seule (RG-M17-20), conservé 30 jours
  id             String   @id @default(cuid(2))
  organizationId String
  membershipId   String
  title          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  expiresAt      DateTime // +30 j

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership   Membership           @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  messages     AiAssistantMessage[]

  @@index([organizationId, membershipId, updatedAt])
  @@index([expiresAt])
}

model AiAssistantMessage {
  id             String   @id @default(cuid(2))
  // organizationId ajouté (04 §3 : toute table enfant porte organizationId, pour la RLS)
  organizationId String
  threadId       String
  role           String // user | assistant | tool
  content        Json
  interactionId  String?
  createdAt      DateTime @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  thread       AiAssistantThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([organizationId, threadId, createdAt])
}

model AutomationRule {
  // règle « si… alors… » sans IA (RG-M17-23)
  id             String         @id @default(cuid(2))
  organizationId String
  name           String
  trigger        String // "repair_order.status_changed"
  conditions     Json           @default("[]") // [{ field, op, value }]
  actions        Json // [{ type:"send_template", templateKey:"vehicle_ready", channel:"WHATSAPP", withPaymentLink:true }]
  mode           AutomationMode @default(PROPOSE)
  delayMinutes   Int            @default(0)
  siteIds        String[] // vide = tous
  isActive       Boolean        @default(false)
  // écart §14 : date d'activation — seuls les événements postérieurs déclenchent la règle
  activatedAt    DateTime?
  templateKey    String? // modèle fourni d'origine
  createdById    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    Membership?     @relation("AutomationRuleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  runs         AutomationRun[]

  @@index([organizationId, isActive, trigger])
}

enum AutomationMode {
  AUTO
  PROPOSE
}

model AutomationRun {
  id             String    @id @default(cuid(2))
  organizationId String
  ruleId         String
  eventId        String
  status         String // PENDING | SUCCEEDED | FAILED | SKIPPED
  result         Json?
  error          String?
  depth          Int       @default(0)
  // écart §14 : exécution différée (delayMinutes) et réessais (FAILED réessayé 3 fois, §5)
  scheduledFor   DateTime  @default(now())
  attempts       Int       @default(0)
  executedAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rule         AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, eventId])
  @@index([organizationId, status, scheduledFor])
  @@index([organizationId, ruleId, createdAt])
}

// ═══════════════════════════════════════════════════════════════
// Phase 0 — ajouts transverses (04-arbitrages-coherence.md §3)
// ═══════════════════════════════════════════════════════════════

model Holiday {
  // jours fériés — source unique (A1), M15 §14
  id             String   @id @default(cuid(2))
  organizationId String
  siteId         String? // null = tous les sites
  date           DateTime @db.Date
  name           String // "Fête de l'Indépendance"
  kind           String   @default("PUBLIC") // PUBLIC | CLOSURE
  isEstimated    Boolean  @default(false) // fêtes religieuses à confirmer

  organization Organization @relation(fields: [organizationId], references: [id])
  site         Site?        @relation(fields: [siteId], references: [id])

  @@unique([organizationId, siteId, date])
}

model PortalToken {
  // liens publics du portail — mécanisme unique (A2), M14 §14
  id             String            @id @default(cuid(2))
  organizationId String
  tokenHash      String            @unique // sha256 du jeton clair
  shortCode      String?           @unique // alias SMS /l/{code}
  scope          PortalScope
  targetId       String // id de la ressource ciblée
  customerId     String
  status         PortalTokenStatus @default(ACTIVE)
  expiresAt      DateTime
  createdById    String? // null = automatique
  reminderId     String? // relance ayant généré le lien
  firstOpenedAt  DateTime?
  lastOpenedAt   DateTime?
  openCount      Int               @default(0)
  revokedAt      DateTime?
  revokeReason   String?
  createdAt      DateTime          @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id])
  customer     Customer       @relation(fields: [customerId], references: [id])
  createdBy    Membership?    @relation("PortalTokenCreatedBy", fields: [createdById], references: [id])
  reminder     Reminder?      @relation(fields: [reminderId], references: [id])
  accesses     PortalAccess[]
  // targetId est polymorphe (scope détermine la table cible : Quote, Invoice, RepairOrder, Appointment, Vehicle…) : pas de @relation unique possible.

  @@index([organizationId, scope, targetId])
}

enum PortalScope {
  QUOTE
  INVOICE
  REPAIR_ORDER
  APPOINTMENT
  BOOKING
  VEHICLE
  STATEMENT
  SURVEY
}

enum PortalTokenStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

model PortalAccess {
  // M14 §14 — journal des ouvertures et actions du portail (purgé après 12 mois)
  id              String   @id @default(cuid(2))
  organizationId  String
  portalTokenId   String?
  portalSessionId String?
  action          String // open | quote_decide | pay_click | book | cancel | feedback | new_link_request | otp_login | document_open
  ipPrefix        String? // IP tronquée /24 (IPv6 /48)
  userAgent       String?
  createdAt       DateTime @default(now())

  organization  Organization   @relation(fields: [organizationId], references: [id])
  portalToken   PortalToken?   @relation(fields: [portalTokenId], references: [id], onDelete: Cascade)
  portalSession PortalSession? @relation(fields: [portalSessionId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([portalTokenId, action, createdAt])
}

model PortalSession {
  // M14 §14 — accès « Mon espace » par OTP téléphone (RG-M14-22)
  id             String    @id @default(cuid(2))
  organizationId String
  phone          String // E.164
  tokenHash      String    @unique
  expiresAt      DateTime
  revokedAt      DateTime?
  lastSeenAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id])
  accesses     PortalAccess[]

  @@index([organizationId, phone])
}

model PortalOtpChallenge {
  // M14 RG-M14-22 — défi OTP (code haché, 5 min, 5 essais) ; hors §14 : stockage nécessaire à l'OTP
  id             String    @id @default(cuid(2))
  organizationId String
  phone          String // E.164
  codeHash       String
  expiresAt      DateTime
  attempts       Int       @default(0)
  consumedAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, phone, createdAt])
}

model CustomerFeedback {
  // M14 §14 — avis après restitution (RG-M14-21) : un seul par OR
  id             String   @id @default(cuid(2))
  organizationId String
  siteId         String
  customerId     String
  repairOrderId  String   @unique
  rating         Int // 1-5
  comment        String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  site         Site         @relation(fields: [siteId], references: [id])
  customer     Customer     @relation(fields: [customerId], references: [id])
  repairOrder  RepairOrder  @relation(fields: [repairOrderId], references: [id])

  @@index([organizationId, createdAt])
}
