// Schéma de référence : docs/02-modele-donnees.md
// Évolutions Phase 0 : docs/04-arbitrages-coherence.md §3
// Toute évolution future passe par une migration + mise à jour de 02-modele-donnees.md (même commit).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

// ═══════════════════════════════════════════════════════════════
// Organisation, sites, utilisateurs
// ═══════════════════════════════════════════════════════════════

model Organization {
  id                    String        @id @default(cuid(2))
  name                  String
  legalName             String?
  rccm                  String?
  ncc                   String? // numéro de compte contribuable
  taxRegime             TaxRegime     @default(RSI)
  vatRate               Int           @default(18) // en %
  vatEnabled            Boolean       @default(true)
  currency              String        @default("XOF")
  timezone              String        @default("Africa/Abidjan")
  phone                 String?
  email                 String?
  address               String?
  city                  String?       @default("Abidjan")
  logoUrl               String?
  invoiceFooter         String?
  plan                  PlanTier      @default(STARTER)
  operatingMode         OperatingMode @default(FULL) // REMINDERS_ONLY si le garage garde son ancien logiciel
  settings              Json          @default("{}") // préférences diverses (voir M15) : onboarding { step, skipped[] }, security { otpOnNewDevice: Role[] }
  onboardingCompletedAt DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  sites                  Site[]
  memberships            Membership[]
  customers              Customer[]
  customerContacts       CustomerContact[]
  vehicles               Vehicle[]
  mileageReadings        MileageReading[]
  vehicleEvents          VehicleEvent[]
  appointments           Appointment[]
  repairOrders           RepairOrder[]
  repairOrderLines       RepairOrderLine[]
  inspections            Inspection[]
  inspectionItems        InspectionItem[]
  inspectionTemplates    InspectionTemplate[]
  laborOperations        LaborOperation[]
  orStatusHistory        RepairOrderStatusHistory[] // M04 §14
  vehicleRecommendations VehicleRecommendation[] // M04 §14
  timeEntries            TimeEntry[]
  attendances            Attendance[]
  quotes                 Quote[]
  quoteLines             QuoteLine[]
  products               Product[]
  stockLevels            StockLevel[]
  stockMovements         StockMovement[]
  suppliers              Supplier[]
  purchaseOrders         PurchaseOrder[]
  purchaseOrderLines     PurchaseOrderLine[]
  invoices               Invoice[]
  invoiceLines           InvoiceLine[]
  payments               Payment[]
  paymentAllocations     PaymentAllocation[]
  paymentLinks           PaymentLink[]
  cashSessions           CashSession[]
  expenses               Expense[]
  collectionCases        CollectionCase[]
  paymentPromises        PaymentPromise[]
  collectionNotes        CollectionNote[]
  creditOverrides        CreditOverride[]
  paymentAttributions    PaymentAttribution[]
  receivableSnapshots    ReceivableSnapshot[]
  reminderRules          ReminderRule[]
  reminders              Reminder[]
  reminderSuppressions   ReminderSuppression[]
  messageTemplates       MessageTemplate[]
  conversations          Conversation[]
  messages               Message[]
  messageStatusEvents    MessageStatusEvent[]
  messageAttempts        MessageAttempt[]
  quickReplies           QuickReply[]
  channelConfigs         ChannelConfig[]
  optOuts                OptOut[]
  paymentProviderConfigs PaymentProviderConfig[]
  fneConfig              FneConfig?
  dataSources            DataSource[]
  importJobs             ImportJob[]
  importRowErrors        ImportRowError[]
  externalRefs           ExternalRef[]
  apiKeys                ApiKey[]
  webhookEndpoints       WebhookEndpoint[]
  insuranceCompanies     InsuranceCompany[]
  insuranceClaims        InsuranceClaim[]
  attachments            Attachment[]
  documentSequences      DocumentSequence[]
  auditLogs              AuditLog[]
  domainEvents           DomainEvent[]
  notifications          Notification[]
  aiInteractions         AiInteraction[]
  holidays               Holiday[]
  portalTokens           PortalToken[]
  invitations            Invitation[]
  rolePermissions        RolePermission[]
  trustedDevices         TrustedDevice[]
  customerNotes          CustomerNote[]
  duplicateDismissals    DuplicateDismissal[]
  customerSegments       CustomerSegment[]
  vehicleMakes           VehicleMake[]
  vehicleModels          VehicleModel[]
}

enum TaxRegime {
  RNI
  RSI
  RMI
  ENTREPRENANT
}

enum PlanTier {
  STARTER
  PRO
  NETWORK
}

enum OperatingMode {
  FULL
  REMINDERS_ONLY
}

model Site {
  id             String   @id @default(cuid(2))
  organizationId String
  name           String // "Atelier Yopougon"
  code           String // "YOP" (préfixe de numérotation)
  address        String?
  commune        String?
  phone          String?
  whatsappNumber String?
  openingHours   Json     @default("{}") // { mon: [["08:00","18:00"]], ... }
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id])
  bays           Bay[]
  appointments   Appointment[]
  repairOrders   RepairOrder[]
  quotes         Quote[]
  stockLevels    StockLevel[]
  stockMovements StockMovement[]
  purchaseOrders PurchaseOrder[]
  invoices       Invoice[]
  payments       Payment[]
  cashSessions   CashSession[]
  expenses       Expense[]
  holidays       Holiday[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model Bay {
  // pont / poste de travail
  id             String   @id @default(cuid(2))
  organizationId String
  siteId         String
  name           String // "Pont 1", "Carrosserie", "Diagnostic"
  type           BayType  @default(LIFT)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  site         Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  repairOrders RepairOrder[]

  @@index([organizationId, siteId])
}

enum BayType {
  LIFT
  DIAGNOSTIC
  BODYWORK
  PAINT
  WASH
  OTHER
}

model User {
  id                       String    @id @default(cuid(2))
  name                     String
  email                    String?   @unique
  phone                    String?   @unique // E.164
  // Mot de passe NON stocké ici : Better Auth le garde dans Account.password
  // (providerId "credential"), cf. 04-arbitrages-coherence.md A6.
  emailVerifiedAt          DateTime?
  phoneVerifiedAt          DateTime?
  avatarUrl                String?
  locale                   String    @default("fr")
  isActive                 Boolean   @default(true)
  failedLoginCount         Int       @default(0)
  lockedUntil              DateTime?
  lockCount                Int       @default(0) // récidives depuis le dernier succès (RG-M01-05)
  lastLoginAt              DateTime?
  lastActiveOrganizationId String?
  lastActiveSiteId         String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  memberships Membership[]
  auditLogs   AuditLog[]
  sessions    Session[]
  accounts    Account[]
}

model Membership {
  id                 String    @id @default(cuid(2))
  organizationId     String
  userId             String
  role               Role
  permissions        String[] // surcharges explicites "module:action"
  siteIds            String[] // vide = tous les sites
  hourlyCost         Int? // coût horaire interne (mécaniciens)
  skills             String[] // "moteur", "électricité", "climatisation", "carrosserie"
  pinHash            String? // M01/M06 : code PIN atelier (connexion tablette)
  pinFailedCount     Int       @default(0)
  invitedById        String? // Membership.id de l'invitant
  isActive           Boolean   @default(true)
  deactivatedAt      DateTime?
  deactivationReason String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  mileageReadingsCreated      MileageReading[]      @relation("MileageReadingCreatedBy")
  vehicleEventsCreated        VehicleEvent[]        @relation("VehicleEventCreatedBy")
  appointmentsAsAdvisor       Appointment[]         @relation("AppointmentAdvisor")
  repairOrdersAsAdvisor       RepairOrder[]         @relation("RepairOrderAdvisor")
  repairOrdersAsQc            RepairOrder[]         @relation("RepairOrderQc")
  repairOrderLinesAssigned    RepairOrderLine[]     @relation("RepairOrderLineAssignee")
  inspectionsPerformed        Inspection[]          @relation("InspectionPerformedBy")
  timeEntries                 TimeEntry[]
  attendances                 Attendance[]
  quotesCreated               Quote[]               @relation("QuoteCreatedBy")
  stockMovementsCreated       StockMovement[]       @relation("StockMovementCreatedBy")
  paymentsReceived            Payment[]             @relation("PaymentReceivedBy")
  cashSessionsOpened          CashSession[]         @relation("CashSessionOpenedBy")
  cashSessionsClosed          CashSession[]         @relation("CashSessionClosedBy")
  expensesCreated             Expense[]             @relation("ExpenseCreatedBy")
  collectionCasesAssigned     CollectionCase[]      @relation("CollectionCaseAssignee")
  paymentPromisesCreated      PaymentPromise[]      @relation("PaymentPromiseCreatedBy")
  collectionNotesCreated      CollectionNote[]      @relation("CollectionNoteCreatedBy")
  remindersApproved           Reminder[]            @relation("ReminderApprovedBy")
  remindersEdited             Reminder[]            @relation("ReminderEditedBy")
  reminderSuppressionsCreated ReminderSuppression[] @relation("ReminderSuppressionCreatedBy")
  conversationsAssigned       Conversation[]        @relation("ConversationAssignee")
  messagesSent                Message[]             @relation("MessageSentBy")
  importJobsCreated           ImportJob[]           @relation("ImportJobCreatedBy")
  attachmentsCreated          Attachment[]          @relation("AttachmentCreatedBy")
  notifications               Notification[]
  aiInteractionsCreated       AiInteraction[]       @relation("AiInteractionCreatedBy")
  invoicesCreated             Invoice[]             @relation("InvoiceCreatedBy")
  portalTokensCreated         PortalToken[]         @relation("PortalTokenCreatedBy")
  customerNotesCreated        CustomerNote[]        @relation("CustomerNoteCreatedBy")
  duplicateDismissalsCreated  DuplicateDismissal[]  @relation("DuplicateDismissalDismissedBy")
  customerSegmentsCreated     CustomerSegment[]     @relation("CustomerSegmentCreatedBy")
  quickRepliesCreated         QuickReply[]          @relation("QuickReplyCreatedBy")

  @@unique([organizationId, userId])
  @@index([organizationId])
}

enum Role {
  OWNER
  MANAGER
  ADVISOR
  MECHANIC
  STOREKEEPER
  CASHIER
  ACCOUNTANT
}

// ═══════════════════════════════════════════════════════════════
// Clients et véhicules
// ═══════════════════════════════════════════════════════════════

enum RecordOrigin {
  NATIVE
  IMPORTED
  API
  SYNC
}

model Customer {
  id                    String       @id @default(cuid(2))
  organizationId        String
  type                  CustomerType @default(INDIVIDUAL)
  firstName             String?
  lastName              String?
  companyName           String?
  displayName           String // calculé : "Kouassi Jean-Marc" ou "SOTRA Logistique SARL"
  civility              Civility?
  phone                 String? // E.164, principal
  phone2                String?
  hasWhatsapp           Boolean? // null = inconnu, détecté au 1er envoi
  whatsappPhone         String? // si différent
  email                 String?
  address               String?
  commune               String?
  ncc                   String? // entreprises
  rccm                  String?
  preferredChannel      Channel? // null = suit l'ordre par défaut
  remindersConsent      Boolean      @default(true)
  marketingConsent      Boolean      @default(false)
  optedOutAt            DateTime? // a répondu STOP
  doNotRemind           Boolean      @default(false) // décision interne
  doNotRemindReason     String?
  paymentTermsDays      Int          @default(0) // 0 = comptant
  creditLimit           Int? // en FCFA
  priceListId           String?
  discountRate          Int? // remise par défaut en %
  riskScore             Int? // 0-100, calculé (M09/M17)
  tags                  String[]
  notes                 String?
  source                String? // "import", "portail", "comptoir"
  origin                RecordOrigin @default(NATIVE)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  deletedAt             DateTime?
  // M02 §14
  consentUpdatedAt      DateTime?
  consentSource         String? // counter | phone | whatsapp_reply | portal | import | staff
  mergedIntoId          String? // client cible après fusion (RG-M02-08)
  anonymizedAt          DateTime?
  lastVisitAt           DateTime? // dénormalisé (dernier OR livré ou facture), pour tri/filtre
  // M11 §14
  hasWhatsappCheckedAt  DateTime?
  emailInvalidAt        DateTime?
  // M10 §14
  phoneInvalidAt        DateTime? // RG-M10-32 : 2 échecs définitifs sur ce numéro → plus d'envoi
  // M09 §14
  creditHold            Boolean      @default(false)
  creditHoldReason      String?
  riskComponents        Json? // { A, B, C, D, E } pour l'affichage (RG-M09-12)
  // M05 §14
  requiresPurchaseOrder Boolean      @default(false) // flotte : bon de commande client exigé

  organization    Organization      @relation(fields: [organizationId], references: [id])
  vehicles        Vehicle[]
  contacts        CustomerContact[]
  appointments    Appointment[]
  repairOrders    RepairOrder[]
  quotes          Quote[]
  invoices        Invoice[]
  payments        Payment[]
  collectionCases CollectionCase[]
  creditOverrides CreditOverride[]
  reminders       Reminder[]
  conversations   Conversation[]
  messages        Message[]
  insuranceClaims InsuranceClaim[]
  portalTokens    PortalToken[]
  customerNotes   CustomerNote[]
  // index trigram (migration SQL) :
  // CREATE INDEX customer_display_name_trgm ON "Customer" USING gin ("displayName" gin_trgm_ops);

  @@index([organizationId, displayName])
  @@index([organizationId, phone])
  @@index([organizationId, phone2])
  @@index([organizationId, email])
}

enum CustomerType {
  INDIVIDUAL
  COMPANY
}

enum Civility {
  M
  MME
  MLLE
}

enum Channel {
  WHATSAPP
  SMS
  EMAIL
}

model CustomerContact {
  // interlocuteurs d'une entreprise
  id                String    @id @default(cuid(2))
  organizationId    String
  customerId        String
  name              String
  role              String? // "Responsable flotte", "Comptabilité"
  phone             String?
  phone2            String?
  email             String?
  receivesInvoices  Boolean   @default(false)
  receivesReminders Boolean   @default(false)
  isPrimary         Boolean   @default(false)
  createdAt         DateTime  @default(now())
  deletedAt         DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([organizationId, customerId])
}

model Vehicle {
  id                        String        @id @default(cuid(2))
  organizationId            String
  customerId                String
  plate                     String // normalisée : majuscules, sans espaces multiples
  plateCompact              String        @default("") // "2547GH01" — unicité et recherche (RG-M02-05)
  plateType                 PlateType     @default(STANDARD)
  usage                     VehicleUsage  @default(PRIVATE)
  vin                       String?
  make                      String // Toyota
  model                     String // Corolla
  makeId                    String? // lien catalogue (facultatif, make/model restent la vérité affichée)
  modelId                   String?
  version                   String?
  year                      Int?
  firstRegistrationDate     DateTime?     @db.Date
  fuel                      FuelType?
  transmission              Transmission?
  engineCode                String?
  color                     String?
  fleetNumber               String? // n° interne flotte client
  driverName                String?
  driverPhone               String?
  // Kilométrage
  currentMileage            Int?
  currentMileageAt          DateTime?
  avgKmPerDay               Float? // calculé à partir des relevés
  estimatedMileage          Int? // estimé du jour (worker)
  odometerOffset            Int           @default(0) // après remplacement de compteur (RG-M02-09)
  odometerInMiles           Boolean       @default(false)
  // Visite technique
  inspectionLastDate        DateTime?     @db.Date
  inspectionExpiryDate      DateTime?     @db.Date
  inspectionCenter          String?
  // Révision
  serviceIntervalKm         Int? // ex. 10000
  serviceIntervalMonths     Int? // ex. 6
  lastServiceDate           DateTime?     @db.Date
  lastServiceMileage        Int?
  nextServiceDueDate        DateTime?     @db.Date // calculé (M10)
  nextServiceDueMileage     Int? // calculé
  nextServiceTrigger        String? // "DATE" | "MILEAGE" (RG-M02-13)
  // M10 §14
  serviceDueBasis           String? // "date" | "km" (laquelle a déterminé l'échéance)
  inspectionExpiryEstimated Boolean       @default(false) // déduite de la dernière VT (RG-M10-30)
  dataQualityFlags          String[] // "inspection_date_suspect", "duplicate_plate"
  // Assurance
  insuranceCompanyId        String?
  insuranceExpiryDate       DateTime?     @db.Date
  insurancePolicyNumber     String?
  notes                     String?
  mergedIntoId              String? // véhicule cible après fusion d'un doublon (RG-M02-08)
  origin                    RecordOrigin  @default(NATIVE)
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt
  deletedAt                 DateTime?

  organization     Organization      @relation(fields: [organizationId], references: [id])
  customer         Customer          @relation(fields: [customerId], references: [id])
  insuranceCompany InsuranceCompany? @relation(fields: [insuranceCompanyId], references: [id])
  vehicleMake      VehicleMake?      @relation(fields: [makeId], references: [id])
  vehicleModel     VehicleModel?     @relation(fields: [modelId], references: [id])
  mileageReadings  MileageReading[]
  events           VehicleEvent[]
  appointments     Appointment[]
  repairOrders     RepairOrder[]
  quotes           Quote[]
  invoices         Invoice[]
  reminders        Reminder[]
  insuranceClaims  InsuranceClaim[]
  customerNotes    CustomerNote[]
  // unicité partielle + index trigram (migration SQL) :
  // CREATE UNIQUE INDEX vehicle_plate_unique ON "Vehicle" ("organizationId","plateCompact")
  //   WHERE "deletedAt" IS NULL AND "plateType" <> 'NONE';
  // CREATE INDEX vehicle_plate_trgm ON "Vehicle" USING gin ("plateCompact" gin_trgm_ops);

  @@index([organizationId, plate])
  @@index([organizationId, plateCompact])
  @@index([organizationId, vin])
  @@index([organizationId, inspectionExpiryDate])
  @@index([organizationId, nextServiceDueDate])
  @@index([organizationId, customerId])
}

enum PlateType {
  STANDARD
  TEMPORARY
  DIPLOMATIC
  GOVERNMENT
  FOREIGN
  NONE
  OTHER
}

enum VehicleUsage {
  PRIVATE
  TAXI
  TRANSPORT
  UTILITY
  RENTAL
  OTHER
}

enum FuelType {
  PETROL
  DIESEL
  HYBRID
  ELECTRIC
  LPG
  OTHER
}

enum Transmission {
  MANUAL
  AUTOMATIC
}

model MileageReading {
  id             String        @id @default(cuid(2))
  organizationId String
  vehicleId      String
  mileage        Int
  readAt         DateTime
  source         MileageSource
  repairOrderId  String?
  createdById    String?
  isOutlier      Boolean       @default(false)
  createdAt      DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  vehicle      Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  repairOrder  RepairOrder? @relation(fields: [repairOrderId], references: [id])
  createdBy    Membership?  @relation("MileageReadingCreatedBy", fields: [createdById], references: [id])

  @@index([organizationId, vehicleId])
  @@index([vehicleId, readAt])
}

enum MileageSource {
  RECEPTION
  IMPORT
  CUSTOMER
  MANUAL
  INVOICE
}

model VehicleEvent {
  // historique libre (VT faite, accident, changement de propriétaire)
  id             String   @id @default(cuid(2))
  organizationId String
  vehicleId      String
  type           String
  occurredAt     DateTime
  data           Json     @default("{}")
  createdById    String?

  organization Organization @relation(fields: [organizationId], references: [id])
  vehicle      Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  createdBy    Membership?  @relation("VehicleEventCreatedBy", fields: [createdById], references: [id])

  @@index([organizationId, vehicleId])
}

model CustomerNote {
  // notes internes datées (chronologie, RG-M02-10 US-M02-10)
  id             String    @id @default(cuid(2))
  organizationId String
  customerId     String
  vehicleId      String?
  body           String
  pinned         Boolean   @default(false)
  createdById    String?
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicle      Vehicle?     @relation(fields: [vehicleId], references: [id])
  createdBy    Membership?  @relation("CustomerNoteCreatedBy", fields: [createdById], references: [id])

  @@index([organizationId, customerId])
}

model DuplicateDismissal {
  // paires de doublons ignorées (RG-M02-07)
  id             String   @id @default(cuid(2))
  organizationId String
  entity         String // customer | vehicle
  idA            String // plus petit des deux id (ordre lexical)
  idB            String
  dismissedById  String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  dismissedBy  Membership?  @relation("DuplicateDismissalDismissedBy", fields: [dismissedById], references: [id])

  @@unique([organizationId, entity, idA, idB])
}

model CustomerSegment {
  // segments enregistrés (M10 campagnes, M12 ; RG-M02-14)
  id             String   @id @default(cuid(2))
  organizationId String
  name           String
  filters        Json // mêmes clés que customer.list / vehicle.list
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  createdBy    Membership?  @relation("CustomerSegmentCreatedBy", fields: [createdById], references: [id])
}

model VehicleMake {
  // catalogue marques (RG-M02-20) ; organizationId null = catalogue global (platform)
  id             String  @id @default(cuid(2))
  organizationId String?
  name           String // "Toyota"
  isActive       Boolean @default(true)

  organization Organization?  @relation(fields: [organizationId], references: [id])
  models       VehicleModel[]
  vehicles     Vehicle[]

  @@unique([organizationId, name])
}

model VehicleModel {
  id                    String    @id @default(cuid(2))
  organizationId        String?
  makeId                String
  name                  String // "Corolla"
  yearFrom              Int?
  yearTo                Int?
  defaultFuel           FuelType?
  serviceIntervalKm     Int? // 10000
  serviceIntervalMonths Int? // 12
  isActive              Boolean   @default(true)

  organization Organization? @relation(fields: [organizationId], references: [id])
  make         VehicleMake   @relation(fields: [makeId], references: [id], onDelete: Cascade)
  vehicles     Vehicle[]

  @@unique([makeId, organizationId, name])
}

// ═══════════════════════════════════════════════════════════════
// Rendez-vous
// ═══════════════════════════════════════════════════════════════

model Appointment {
  id             String            @id @default(cuid(2))
  organizationId String
  siteId         String
  customerId     String
  vehicleId      String?
  bayId          String?
  advisorId      String? // Membership.id
  startsAt       DateTime
  endsAt         DateTime
  type           AppointmentType
  status         AppointmentStatus @default(BOOKED)
  source         AppointmentSource @default(STAFF)
  reminderId     String? // relance à l'origine du RDV (attribution M12)
  notes          String?
  repairOrderId  String? // OR créé à l'arrivée
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization            Organization  @relation(fields: [organizationId], references: [id])
  site                    Site          @relation(fields: [siteId], references: [id])
  customer                Customer      @relation(fields: [customerId], references: [id])
  vehicle                 Vehicle?      @relation(fields: [vehicleId], references: [id])
  bay                     Bay?          @relation(fields: [bayId], references: [id])
  advisor                 Membership?   @relation("AppointmentAdvisor", fields: [advisorId], references: [id])
  reminder                Reminder?     @relation("AppointmentReminder", fields: [reminderId], references: [id])
  repairOrder             RepairOrder?  @relation("AppointmentResultingOrder", fields: [repairOrderId], references: [id])
  originatingRepairOrders RepairOrder[] @relation("RepairOrderOrigin")
  linkedReminders         Reminder[]    @relation("ReminderAppointment")

  @@index([organizationId, siteId, startsAt])
  @@index([organizationId, customerId])
}

enum AppointmentType {
  SERVICE
  INSPECTION_PREP
  REPAIR
  DIAGNOSTIC
  BODYWORK
  TIRES
  OTHER
}

enum AppointmentStatus {
  BOOKED
  CONFIRMED
  ARRIVED
  NO_SHOW
  CANCELLED
  COMPLETED
}

enum AppointmentSource {
  STAFF
  PHONE
  WHATSAPP
  PORTAL
  REMINDER
}

// ═══════════════════════════════════════════════════════════════
// Ordres de réparation
// ═══════════════════════════════════════════════════════════════

model RepairOrder {
  id                     String            @id @default(cuid(2))
  organizationId         String
  siteId                 String
  number                 String // OR-YOP-2026-00042
  customerId             String
  vehicleId              String
  appointmentId          String?
  advisorId              String?
  bayId                  String?
  cashOnly               Boolean           @default(false) // M09 §14 : OR ouvert sous blocage crédit sans dérogation
  status                 RepairOrderStatus @default(DRAFT)
  priority               Priority          @default(NORMAL)
  mileageIn              Int?
  fuelLevel              Int? // 0-8 (huitièmes)
  complaint              String? // doléances du client
  diagnosis              String?
  checkIn                Json              @default("{}") // état des lieux : rayures, objets, accessoires (M04)
  customerSignatureUrl   String?
  signedAt               DateTime?
  promisedAt             DateTime? // date de restitution promise
  startedAt              DateTime?
  completedAt            DateTime?
  deliveredAt            DateTime?
  qcById                 String?
  qcAt                   DateTime?
  insuranceClaimId       String?
  internalNotes          String?
  totalEstimate          Int               @default(0)
  origin                 RecordOrigin      @default(NATIVE)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  deletedAt              DateTime?
  // M04 §14
  publicToken            String?           @unique // hash du jeton portail (A2) : suivi client / signature à distance
  isComeback             Boolean           @default(false)
  comebackOfId           String? // OR d'origine (retour sur travaux)
  warrantyDecision       WarrantyDecision?
  warrantyDecisionReason String?
  waitingPartsSince      DateTime?
  qcChecklist            Json? // [{ key, label, result: OK|NOK|NA }] + roadTest
  deliverySignatureUrl   String?
  cancelledAt            DateTime?
  cancelReason           String?
  invoicedAt             DateTime?
  createdById            String? // Membership.id
  readyAt                DateTime? // M04 : passage en READY (ancre VEHICLE_READY M10, frais de gardiennage)
  clientRequestId        String? // M04 : idempotence de la réception hors-ligne (US-M04-01)

  organization          Organization               @relation(fields: [organizationId], references: [id])
  site                  Site                       @relation(fields: [siteId], references: [id])
  customer              Customer                   @relation(fields: [customerId], references: [id])
  vehicle               Vehicle                    @relation(fields: [vehicleId], references: [id])
  appointment           Appointment?               @relation("RepairOrderOrigin", fields: [appointmentId], references: [id])
  advisor               Membership?                @relation("RepairOrderAdvisor", fields: [advisorId], references: [id])
  bay                   Bay?                       @relation(fields: [bayId], references: [id])
  qcBy                  Membership?                @relation("RepairOrderQc", fields: [qcById], references: [id])
  insuranceClaim        InsuranceClaim?            @relation(fields: [insuranceClaimId], references: [id])
  lines                 RepairOrderLine[]
  inspections           Inspection[]
  mileageReadings       MileageReading[]
  quotes                Quote[]
  invoices              Invoice[]
  timeEntries           TimeEntry[]
  purchaseOrders        PurchaseOrder[]
  resultingAppointments Appointment[]              @relation("AppointmentResultingOrder")
  stockMovements        StockMovement[]
  comebackOf            RepairOrder?               @relation("RepairOrderComeback", fields: [comebackOfId], references: [id])
  comebacks             RepairOrder[]              @relation("RepairOrderComeback")
  statusHistory         RepairOrderStatusHistory[]

  @@unique([organizationId, number])
  @@unique([organizationId, clientRequestId])
  @@index([organizationId, status])
  @@index([organizationId, vehicleId])
  @@index([organizationId, siteId, status])
}

enum WarrantyDecision {
  COVERED
  NOT_COVERED
  PARTIAL
}

enum RepairOrderStatus {
  DRAFT
  CHECKED_IN
  DIAGNOSING
  AWAITING_APPROVAL
  APPROVED
  IN_PROGRESS
  WAITING_PARTS
  QUALITY_CHECK
  READY
  DELIVERED
  INVOICED
  CANCELLED
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model RepairOrderLine {
  id                    String        @id @default(cuid(2))
  organizationId        String
  repairOrderId         String
  type                  LineType
  productId             String?
  laborOperationId      String?
  description           String
  quantity              Float // heures pour la MO, unités pour les pièces
  unitPrice             Int
  discountRate          Int           @default(0)
  vatRate               Int
  assignedToId          String? // Membership.id du mécanicien
  status                LineStatus    @default(PENDING)
  approval              ApprovalState @default(NOT_REQUIRED)
  quoteLineId           String?
  payer                 Payer         @default(CUSTOMER)
  sortOrder             Int           @default(0)
  // M04 §14
  isCustomerSupplied    Boolean       @default(false) // pièce fournie par le client (unitPrice 0, non garantie)
  costPrice             Int? // coût unitaire (sous-traitance, pièce hors stock)
  supplierId            String? // sous-traitant / fournisseur ponctuel (relation branchée par M07)
  subcontractStatus     String? // TO_SEND | SENT | RETURNED
  subcontractExpectedAt DateTime?
  approvalSource        String? // CHECK_IN | PRE_AUTHORIZED | QUOTE | PHONE | IN_PERSON
  inspectionItemId      String?
  warrantyMonths        Int?
  warrantyKm            Int?
  warrantyUntilDate     DateTime?     @db.Date // figé à la livraison
  warrantyUntilMileage  Int?
  completedAt           DateTime?
  completedById         String? // Membership.id
  cancelReason          String? // M04 : motif d'annulation/refus de la ligne (historique)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id])
  repairOrder    RepairOrder     @relation(fields: [repairOrderId], references: [id], onDelete: Cascade)
  product        Product?        @relation(fields: [productId], references: [id])
  laborOperation LaborOperation? @relation(fields: [laborOperationId], references: [id])
  assignedTo     Membership?     @relation("RepairOrderLineAssignee", fields: [assignedToId], references: [id])
  quoteLine      QuoteLine?      @relation(fields: [quoteLineId], references: [id])
  timeEntries    TimeEntry[]

  @@index([organizationId, repairOrderId])
  @@index([repairOrderId])
}

enum LineType {
  LABOR
  PART
  SUBCONTRACT
  FEE
  CONSUMABLE
}

enum LineStatus {
  PENDING
  IN_PROGRESS
  DONE
  CANCELLED
}

enum ApprovalState {
  NOT_REQUIRED
  PENDING
  APPROVED
  DECLINED
}

enum Payer {
  CUSTOMER
  INSURANCE
  WARRANTY
  INTERNAL
}

model Inspection {
  // inspection multipoints
  id             String    @id @default(cuid(2))
  organizationId String
  repairOrderId  String
  templateId     String?
  performedById  String?
  completedAt    DateTime?
  createdAt      DateTime  @default(now()) // M04 §14
  summary        Json? // M04 §14 : { urgent, watch, ok, notChecked }

  organization Organization        @relation(fields: [organizationId], references: [id])
  repairOrder  RepairOrder         @relation(fields: [repairOrderId], references: [id], onDelete: Cascade)
  template     InspectionTemplate? @relation(fields: [templateId], references: [id])
  performedBy  Membership?         @relation("InspectionPerformedBy", fields: [performedById], references: [id])
  items        InspectionItem[]

  @@index([organizationId, repairOrderId])
}

model InspectionItem {
  id                    String           @id @default(cuid(2))
  organizationId        String
  inspectionId          String
  category              String // Freinage, Pneumatiques, Éclairage…
  label                 String // "Plaquettes avant"
  result                InspectionResult
  measurement           String?
  comment               String?
  photoUrls             String[]
  recommendedProductIds String[]
  recommendedLaborIds   String[]
  addedToQuote          Boolean          @default(false)
  shareWithCustomer     Boolean          @default(true) // M04 §14
  sortOrder             Int              @default(0) // M04 §14

  organization Organization @relation(fields: [organizationId], references: [id])
  inspection   Inspection   @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([organizationId, inspectionId])
}

enum InspectionResult {
  OK
  WATCH
  URGENT
  NOT_CHECKED
}

model InspectionTemplate {
  id             String  @id @default(cuid(2))
  organizationId String
  name           String
  items          Json // [{ category, label, measurementUnit?, recommendedLaborCode?, recommendedProductCategory? }]
  isDefault      Boolean @default(false) // M04 §14
  isActive       Boolean @default(true) // M04 §14

  organization Organization @relation(fields: [organizationId], references: [id])
  inspections  Inspection[]

  @@index([organizationId])
}

model LaborOperation {
  // catalogue de main-d'œuvre
  id                  String        @id @default(cuid(2))
  organizationId      String
  code                String
  name                String // "Vidange moteur + filtre"
  category            String?
  standardHours       Float // temps barème
  rateType            LaborRateType @default(STANDARD)
  fixedPrice          Int? // forfait éventuel
  isActive            Boolean       @default(true)
  // M05 §14
  customerDescription String? // explication par défaut pour le client
  defaultParts        Json          @default("[]") // [{ productId? , category?, quantity }]
  vehicleOverrides    Json          @default("[]") // [{ make, model?, yearFrom?, yearTo?, standardHours }]
  isServiceOperation  Boolean       @default(false) // compte comme « révision » (M02 RG-M02-13)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id])
  repairOrderLines RepairOrderLine[]
  quoteLines       QuoteLine[]
  invoiceLines     InvoiceLine[]

  @@unique([organizationId, code])
}

model RepairOrderStatusHistory {
  // M04 §14 — une ligne par transition de la machine à états
  id             String             @id @default(cuid(2))
  organizationId String
  repairOrderId  String
  fromStatus     RepairOrderStatus?
  toStatus       RepairOrderStatus
  transition     String
  reason         String?
  membershipId   String? // null = automatique
  createdAt      DateTime           @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  repairOrder  RepairOrder  @relation(fields: [repairOrderId], references: [id], onDelete: Cascade)

  @@index([repairOrderId, createdAt])
  @@index([organizationId])
}

model VehicleRecommendation {
  // M04 §14 — travaux conseillés non réalisés (relance M10 RECOMMENDED_WORK, A8)
  id               String           @id @default(cuid(2))
  organizationId   String
  vehicleId        String
  customerId       String
  repairOrderId    String?
  inspectionItemId String?
  quoteLineId      String?
  label            String // "Amortisseurs arrière"
  severity         InspectionResult // WATCH | URGENT
  estimatedAmount  Int? // TTC
  remindAt         DateTime?        @db.Date // défaut : +90 jours
  status           String           @default("OPEN") // OPEN | DONE | DISMISSED
  createdAt        DateTime         @default(now())
  resolvedAt       DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, vehicleId, status])
}

enum LaborRateType {
  STANDARD
  DIAGNOSTIC
  BODYWORK
  ELECTRICAL
}

model TimeEntry {
  // pointage mécanicien sur une tâche
  id                String    @id @default(cuid(2))
  organizationId    String
  membershipId      String
  repairOrderId     String
  repairOrderLineId String?
  startedAt         DateTime
  endedAt           DateTime?
  pauseMinutes      Int       @default(0)
  note              String?
  source            String    @default("tablet") // tablet | web | offline-sync

  organization    Organization     @relation(fields: [organizationId], references: [id])
  membership      Membership       @relation(fields: [membershipId], references: [id])
  repairOrder     RepairOrder      @relation(fields: [repairOrderId], references: [id], onDelete: Cascade)
  repairOrderLine RepairOrderLine? @relation(fields: [repairOrderLineId], references: [id])

  @@index([organizationId, repairOrderId])
  @@index([organizationId, membershipId])
}

model Attendance {
  // présence journalière
  id             String    @id @default(cuid(2))
  organizationId String
  membershipId   String
  date           DateTime  @db.Date
  clockIn        DateTime?
  clockOut       DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  membership   Membership   @relation(fields: [membershipId], references: [id])

  @@index([organizationId, membershipId, date])
}

// ═══════════════════════════════════════════════════════════════
// Devis
// ═══════════════════════════════════════════════════════════════

model Quote {
  id                     String      @id @default(cuid(2))
  organizationId         String
  siteId                 String
  number                 String // DEV-YOP-2026-00017
  version                Int         @default(1)
  customerId             String
  vehicleId              String?
  repairOrderId          String?
  status                 QuoteStatus @default(DRAFT)
  validUntil             DateTime    @db.Date
  publicToken            String?     @unique
  sentAt                 DateTime?
  viewedAt               DateTime?
  decidedAt              DateTime?
  decisionChannel        String? // portal | whatsapp | in_person | phone
  signatureUrl           String?
  signerName             String?
  declineReason          String?
  subtotal               Int         @default(0)
  discountTotal          Int         @default(0)
  vatTotal               Int         @default(0)
  total                  Int         @default(0)
  insuranceShare         Int         @default(0)
  customerShare          Int         @default(0)
  notes                  String?
  createdById            String?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  // M05 §14
  origin                 QuoteOrigin @default(STANDALONE)
  inspectionId           String?
  insuranceClaimId       String?
  supersedesId           String? // version précédente
  supersededAt           DateTime? // renseigné quand une version plus récente existe
  globalDiscountRate     Int? // %
  globalDiscountAmount   Int? // FCFA (exclusif avec le taux)
  discountReason         String?
  discountApprovalStatus String? // NONE | PENDING | APPROVED | REJECTED
  discountApprovedById   String?
  sentVia                String? // WHATSAPP | SMS | EMAIL | WA_LINK | LINK_ONLY
  sentTo                 String? // adresse effective
  recipientContactId     String?
  decisionHash           String? // SHA-256 du contenu signé
  decisionIp             String?
  decisionUserAgent      String?
  decisionMessageId      String? // message WhatsApp servant de preuve
  recordedById           String? // membre ayant saisi une décision hors portail
  decisionCounterpart    String? // interlocuteur au téléphone
  acceptedTotal          Int         @default(0) // TTC des lignes acceptées (dénormalisé)
  depositAmount          Int?
  depositInvoiceId       String?
  customerPoNumber       String? // bon de commande du client entreprise
  convertedAt            DateTime?
  deletedAt              DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  site         Site         @relation(fields: [siteId], references: [id])
  customer     Customer     @relation(fields: [customerId], references: [id])
  vehicle      Vehicle?     @relation(fields: [vehicleId], references: [id])
  repairOrder  RepairOrder? @relation(fields: [repairOrderId], references: [id])
  createdBy    Membership?  @relation("QuoteCreatedBy", fields: [createdById], references: [id])
  lines        QuoteLine[]
  invoices     Invoice[]
  reminders    Reminder[]

  @@unique([organizationId, number, version])
  @@index([organizationId, status, sentAt])
  @@index([organizationId, repairOrderId])
  @@index([organizationId, customerId])
}

enum QuoteOrigin {
  REPAIR_ORDER
  INSPECTION
  STANDALONE
  APPOINTMENT
  INSURANCE
}

enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  PARTIALLY_ACCEPTED
  DECLINED
  EXPIRED
  CONVERTED
}

model QuoteLine {
  id                  String            @id @default(cuid(2))
  organizationId      String
  quoteId             String
  type                LineType
  productId           String?
  laborOperationId    String?
  description         String
  quantity            Float
  unitPrice           Int
  discountRate        Int               @default(0)
  vatRate             Int
  isOptional          Boolean           @default(false)
  priority            InspectionResult? // URGENT / WATCH pour l'affichage client
  accepted            Boolean? // null = pas encore décidé
  payer               Payer             @default(CUSTOMER)
  sortOrder           Int               @default(0)
  // M05 §14
  groupKey            String? // regroupe MO + pièces d'un même travail
  groupLabel          String? // "Plaquettes avant"
  requiresGroupKey    String? // dépendance (ex. disques nécessite plaquettes)
  customerExplanation String? // texte simple affiché au client
  inspectionItemId    String?
  photoAttachmentIds  String[]
  costPrice           Int? // coût unitaire estimé (marge)
  isCustomerSupplied  Boolean           @default(false)
  declineReason       String?
  lineSubtotal        Int               @default(0) // HT après remise (calculé)
  lineVat             Int               @default(0)
  lineTotal           Int               @default(0)

  organization     Organization      @relation(fields: [organizationId], references: [id])
  quote            Quote             @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product          Product?          @relation(fields: [productId], references: [id])
  laborOperation   LaborOperation?   @relation(fields: [laborOperationId], references: [id])
  repairOrderLines RepairOrderLine[]

  @@index([organizationId, quoteId])
  @@index([quoteId])
}

// ═══════════════════════════════════════════════════════════════
// Stock et achats
// ═══════════════════════════════════════════════════════════════

model Product {
  id                String   @id @default(cuid(2))
  organizationId    String
  sku               String
  name              String
  brand             String?
  oemReference      String?
  barcode           String?
  category          String? // Filtration, Freinage, Lubrifiants…
  unit              String   @default("pièce") // pièce, litre, kit
  purchasePrice     Int      @default(0) // dernier prix d'achat
  averageCost       Int      @default(0) // CMP
  salePrice         Int      @default(0)
  minSalePrice      Int?
  vatRate           Int      @default(18)
  minStock          Int      @default(0)
  reorderQty        Int?
  isStocked         Boolean  @default(true) // false = commandé à la demande
  compatibleWith    String[] // "Toyota Corolla 2014-2019"
  defaultSupplierId String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id])
  defaultSupplier    Supplier?           @relation(fields: [defaultSupplierId], references: [id])
  stockLevels        StockLevel[]
  stockMovements     StockMovement[]
  purchaseOrderLines PurchaseOrderLine[]
  repairOrderLines   RepairOrderLine[]
  quoteLines         QuoteLine[]
  invoiceLines       InvoiceLine[]

  @@unique([organizationId, sku])
}

model StockLevel {
  id             String  @id @default(cuid(2))
  organizationId String
  siteId         String
  productId      String
  onHand         Int     @default(0)
  reserved       Int     @default(0) // réservé pour des OR
  binLocation    String? // "Étagère B3"

  organization Organization @relation(fields: [organizationId], references: [id])
  site         Site         @relation(fields: [siteId], references: [id])
  product      Product      @relation(fields: [productId], references: [id])

  @@unique([siteId, productId])
  @@index([organizationId])
}

model StockMovement {
  id              String            @id @default(cuid(2))
  organizationId  String
  siteId          String
  productId       String
  type            StockMovementType
  quantity        Int // positif entrée, négatif sortie
  unitCost        Int?
  repairOrderId   String?
  purchaseOrderId String?
  reason          String?
  createdById     String?
  createdAt       DateTime          @default(now())

  organization  Organization   @relation(fields: [organizationId], references: [id])
  site          Site           @relation(fields: [siteId], references: [id])
  product       Product        @relation(fields: [productId], references: [id])
  repairOrder   RepairOrder?   @relation(fields: [repairOrderId], references: [id])
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  createdBy     Membership?    @relation("StockMovementCreatedBy", fields: [createdById], references: [id])

  @@index([organizationId, siteId, productId])
}

enum StockMovementType {
  PURCHASE_RECEIPT
  ISSUE_TO_RO
  RETURN_FROM_RO
  ADJUSTMENT
  TRANSFER_OUT
  TRANSFER_IN
  COUNT_CORRECTION
  SUPPLIER_RETURN
}

model Supplier {
  id               String  @id @default(cuid(2))
  organizationId   String
  name             String
  phone            String?
  whatsappPhone    String?
  email            String?
  address          String?
  paymentTermsDays Int     @default(0)
  notes            String?
  isActive         Boolean @default(true)

  organization   Organization    @relation(fields: [organizationId], references: [id])
  products       Product[]
  purchaseOrders PurchaseOrder[]

  @@index([organizationId])
}

model PurchaseOrder {
  id             String              @id @default(cuid(2))
  organizationId String
  siteId         String
  number         String // BC-YOP-2026-00008
  supplierId     String
  status         PurchaseOrderStatus @default(DRAFT)
  orderedAt      DateTime?
  expectedAt     DateTime?
  receivedAt     DateTime?
  repairOrderId  String? // commande liée à un OR
  total          Int                 @default(0)
  notes          String?

  organization   Organization        @relation(fields: [organizationId], references: [id])
  site           Site                @relation(fields: [siteId], references: [id])
  supplier       Supplier            @relation(fields: [supplierId], references: [id])
  repairOrder    RepairOrder?        @relation(fields: [repairOrderId], references: [id])
  lines          PurchaseOrderLine[]
  stockMovements StockMovement[]

  @@unique([organizationId, number])
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrderLine {
  id              String @id @default(cuid(2))
  organizationId  String
  purchaseOrderId String
  productId       String
  quantity        Int
  receivedQty     Int    @default(0)
  unitCost        Int

  organization  Organization  @relation(fields: [organizationId], references: [id])
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])

  @@index([organizationId, purchaseOrderId])
}

// ═══════════════════════════════════════════════════════════════
// Facturation, paiements, caisse
// ═══════════════════════════════════════════════════════════════

model Invoice {
  id                String        @id @default(cuid(2))
  organizationId    String
  siteId            String
  number            String? // attribué à l'émission : FAC-2026-000123 (sans trou)
  type              InvoiceType   @default(INVOICE)
  status            InvoiceStatus @default(DRAFT)
  customerId        String
  vehicleId         String?
  repairOrderId     String?
  quoteId           String?
  creditedInvoiceId String? // pour un avoir
  billTo            Payer         @default(CUSTOMER) // facture client ou facture assurance
  insuranceClaimId  String?
  issuedAt          DateTime?
  dueDate           DateTime?     @db.Date
  subtotal          Int           @default(0)
  discountTotal     Int           @default(0)
  vatTotal          Int           @default(0)
  total             Int           @default(0)
  amountPaid        Int           @default(0)
  balance           Int           @default(0) // total - amountPaid (dénormalisé, maintenu en transaction)
  mileage           Int?
  notes             String?
  publicToken       String?       @unique
  // FNE
  fneStatus         FneStatus     @default(NOT_REQUIRED)
  fneNumber         String?
  fneQrCode         String?
  fneCertifiedAt    DateTime?
  fneError          String?
  fneRaw            Json?
  voidedAt          DateTime?
  voidReason        String?
  origin            RecordOrigin  @default(NATIVE)
  externalNumber    String? // RG-M13-20 : n° dans le logiciel source (import), utilisé dans {{facture.numero}}
  createdById       String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  // M09 §14
  writtenOffAmount  Int?
  writtenOffAt      DateTime?
  writtenOffById    String?
  writeOffReason    String?
  disputedAt        DateTime?
  collectionCaseId  String?

  organization    Organization        @relation(fields: [organizationId], references: [id])
  site            Site                @relation(fields: [siteId], references: [id])
  collectionCase  CollectionCase?     @relation(fields: [collectionCaseId], references: [id])
  customer        Customer            @relation(fields: [customerId], references: [id])
  vehicle         Vehicle?            @relation(fields: [vehicleId], references: [id])
  repairOrder     RepairOrder?        @relation(fields: [repairOrderId], references: [id])
  quote           Quote?              @relation(fields: [quoteId], references: [id])
  creditedInvoice Invoice?            @relation("InvoiceCreditNote", fields: [creditedInvoiceId], references: [id])
  creditNotes     Invoice[]           @relation("InvoiceCreditNote")
  insuranceClaim  InsuranceClaim?     @relation(fields: [insuranceClaimId], references: [id])
  createdBy       Membership?         @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  lines           InvoiceLine[]
  allocations     PaymentAllocation[]
  paymentLinks    PaymentLink[]
  reminders       Reminder[]

  @@unique([organizationId, number])
  @@index([organizationId, status, dueDate])
  @@index([organizationId, customerId, status])
}

enum InvoiceType {
  INVOICE
  CREDIT_NOTE
  DEPOSIT
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
  WRITTEN_OFF
  DISPUTED
}

enum FneStatus {
  NOT_REQUIRED
  PENDING
  CERTIFIED
  FAILED
  MANUAL
}

model InvoiceLine {
  id               String   @id @default(cuid(2))
  organizationId   String
  invoiceId        String
  type             LineType
  productId        String?
  laborOperationId String?
  description      String
  quantity         Float
  unitPrice        Int
  discountRate     Int      @default(0)
  vatRate          Int
  lineSubtotal     Int // calculé et figé à l'émission
  lineVat          Int
  lineTotal        Int
  sortOrder        Int      @default(0)

  organization   Organization    @relation(fields: [organizationId], references: [id])
  invoice        Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product        Product?        @relation(fields: [productId], references: [id])
  laborOperation LaborOperation? @relation(fields: [laborOperationId], references: [id])

  @@index([organizationId, invoiceId])
}

model Payment {
  id             String        @id @default(cuid(2))
  organizationId String
  siteId         String
  customerId     String?
  number         String // REC-2026-000310 (reçu)
  method         PaymentMethod
  amount         Int
  receivedAt     DateTime
  reference      String? // ID transaction Wave/OM, n° chèque
  status         PaymentStatus @default(CONFIRMED)
  provider       String? // cinetpay | wave | manual
  providerRef    String?
  cashSessionId  String?
  receivedById   String?
  unallocated    Int           @default(0) // acompte / trop-perçu
  notes          String?
  origin         RecordOrigin  @default(NATIVE)
  createdAt      DateTime      @default(now())

  organization Organization        @relation(fields: [organizationId], references: [id])
  site         Site                @relation(fields: [siteId], references: [id])
  customer     Customer?           @relation(fields: [customerId], references: [id])
  cashSession  CashSession?        @relation(fields: [cashSessionId], references: [id])
  receivedBy   Membership?         @relation("PaymentReceivedBy", fields: [receivedById], references: [id])
  allocations  PaymentAllocation[]
  paymentLinks PaymentLink[]

  @@unique([organizationId, number])
  @@unique([provider, providerRef])
}

enum PaymentMethod {
  CASH
  WAVE
  ORANGE_MONEY
  MTN_MOMO
  MOOV_MONEY
  CARD
  BANK_TRANSFER
  CHEQUE
  INSURANCE
  OTHER
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
}

model PaymentAllocation {
  id             String @id @default(cuid(2))
  organizationId String
  paymentId      String
  invoiceId      String
  amount         Int

  organization Organization        @relation(fields: [organizationId], references: [id])
  payment      Payment             @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice      Invoice             @relation(fields: [invoiceId], references: [id])
  attribution  PaymentAttribution?

  @@index([organizationId, paymentId])
  @@index([organizationId, invoiceId])
}

model PaymentLink {
  id             String        @id @default(cuid(2))
  organizationId String
  invoiceId      String
  provider       String
  providerRef    String
  url            String
  amount         Int
  status         PaymentStatus @default(PENDING)
  expiresAt      DateTime
  paymentId      String?
  createdAt      DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  invoice      Invoice      @relation(fields: [invoiceId], references: [id])
  payment      Payment?     @relation(fields: [paymentId], references: [id])

  @@index([organizationId, invoiceId])
}

model CashSession {
  // ouverture / clôture de caisse
  id             String    @id @default(cuid(2))
  organizationId String
  siteId         String
  openedById     String
  openedAt       DateTime
  openingFloat   Int
  closedById     String?
  closedAt       DateTime?
  expectedCash   Int?
  countedCash    Int?
  difference     Int?
  notes          String?

  organization Organization @relation(fields: [organizationId], references: [id])
  site         Site         @relation(fields: [siteId], references: [id])
  openedBy     Membership   @relation("CashSessionOpenedBy", fields: [openedById], references: [id])
  closedBy     Membership?  @relation("CashSessionClosedBy", fields: [closedById], references: [id])
  payments     Payment[]
  expenses     Expense[]

  @@index([organizationId, siteId])
}

model Expense {
  // décaissements de caisse (petites dépenses)
  id             String   @id @default(cuid(2))
  organizationId String
  siteId         String
  cashSessionId  String?
  category       String
  amount         Int
  description    String
  paidAt         DateTime
  createdById    String?

  organization Organization @relation(fields: [organizationId], references: [id])
  site         Site         @relation(fields: [siteId], references: [id])
  cashSession  CashSession? @relation(fields: [cashSessionId], references: [id])
  createdBy    Membership?  @relation("ExpenseCreatedBy", fields: [createdById], references: [id])

  @@index([organizationId, siteId])
}

// ═══════════════════════════════════════════════════════════════
// Créances et recouvrement
// ═══════════════════════════════════════════════════════════════

model CollectionCase {
  // un dossier par client ayant un solde en retard
  id                      String            @id @default(cuid(2))
  organizationId          String
  customerId              String
  status                  CollectionStatus  @default(OPEN)
  stage                   Int               @default(0) // palier atteint dans la séquence
  assignedToId            String?
  totalDue                Int               @default(0)
  oldestDueDate           DateTime?         @db.Date
  nextActionAt            DateTime?
  pausedUntil             DateTime?
  closedAt                DateTime?
  closeReason             String?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  // M09 §14
  anchorDate              DateTime?         @db.Date // plus ancienne échéance en retard à l'ouverture (ancre M10)
  overdueDue              Int               @default(0) // part échue de totalDue
  maxDaysOverdue          Int               @default(0)
  escalatedAt             DateTime?
  disputeOpenedAt         DateTime?
  disputeReason           String?
  disputedAmount          Int?
  formalNoticeAt          DateTime?
  formalNoticeDeliveredAt DateTime?
  formalNoticeMethod      String? // email | whatsapp | hand | bailiff
  lastContactAt           DateTime?
  brokenPromiseCount      Int               @default(0)
  unreachableCount        Int               @default(0) // appels « pas de réponse » consécutifs
  previousStatus          CollectionStatus? // restauré à la fin d'une pause

  organization Organization     @relation(fields: [organizationId], references: [id])
  customer     Customer         @relation(fields: [customerId], references: [id])
  assignedTo   Membership?      @relation("CollectionCaseAssignee", fields: [assignedToId], references: [id])
  promises     PaymentPromise[]
  notes        CollectionNote[]
  invoices     Invoice[]

  @@index([organizationId, status])
  @@index([organizationId, customerId])
}

enum CollectionStatus {
  OPEN
  PROMISED
  PAUSED
  DISPUTED
  ESCALATED
  CLOSED_PAID
  CLOSED_WRITTEN_OFF
}

model PaymentPromise {
  id               String        @id @default(cuid(2))
  organizationId   String
  collectionCaseId String
  amount           Int
  promisedDate     DateTime      @db.Date
  channel          String? // téléphone, WhatsApp, en personne
  status           PromiseStatus @default(PENDING)
  createdById      String?
  createdAt        DateTime      @default(now())
  // M09 §14 (organizationId déjà présent, A §3)
  paidAmount       Int           @default(0)
  evaluatedAt      DateTime?
  reminderId       String? // relance à l'origine de la promesse (attribution)
  cancelledReason  String?

  organization   Organization   @relation(fields: [organizationId], references: [id])
  collectionCase CollectionCase @relation(fields: [collectionCaseId], references: [id], onDelete: Cascade)
  createdBy      Membership?    @relation("PaymentPromiseCreatedBy", fields: [createdById], references: [id])

  @@index([organizationId, collectionCaseId])
}

enum PromiseStatus {
  PENDING
  KEPT
  PARTIALLY_KEPT
  BROKEN
  CANCELLED
}

model CollectionNote {
  id               String       @id @default(cuid(2))
  organizationId   String
  collectionCaseId String
  body             String
  type             String       @default("note") // note | call | visit
  callOutcome      CallOutcome? // M09 §14
  callbackAt       DateTime? // M09 §14
  createdById      String?
  createdAt        DateTime     @default(now())

  organization   Organization   @relation(fields: [organizationId], references: [id])
  collectionCase CollectionCase @relation(fields: [collectionCaseId], references: [id], onDelete: Cascade)
  createdBy      Membership?    @relation("CollectionNoteCreatedBy", fields: [createdById], references: [id])

  @@index([organizationId, collectionCaseId])
}

enum CallOutcome {
  REACHED
  NO_ANSWER
  WRONG_NUMBER
  CALLBACK
}

model CreditOverride {
  // M09 §14, RG-M09-10 : dérogation de crédit pour un OR
  id             String    @id @default(cuid(2))
  organizationId String
  customerId     String
  repairOrderId  String?
  requestedById  String
  decidedById    String?
  status         String    @default("PENDING") // PENDING | GRANTED | REFUSED
  reason         String
  decisionReason String?
  createdAt      DateTime  @default(now())
  decidedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  customer     Customer     @relation(fields: [customerId], references: [id])

  @@index([organizationId, customerId])
}

model PaymentAttribution {
  // M09 §14, RG-M09-14 / A10
  id                  String   @id @default(cuid(2))
  organizationId      String
  paymentAllocationId String   @unique
  source              String // reminder | call | spontaneous
  reminderId          String?
  collectionNoteId    String?
  amount              Int
  createdAt           DateTime @default(now())

  organization      Organization      @relation(fields: [organizationId], references: [id])
  paymentAllocation PaymentAllocation @relation(fields: [paymentAllocationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

model ReceivableSnapshot {
  // M09 §14 : photo quotidienne de la balance âgée pour les courbes M12
  id             String   @id @default(cuid(2))
  organizationId String
  siteId         String?
  date           DateTime @db.Date
  notDue         Int
  b0_30          Int
  b31_60         Int
  b61_90         Int
  b90p           Int

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, siteId, date])
}

// ═══════════════════════════════════════════════════════════════
// Relances et messages
// ═══════════════════════════════════════════════════════════════

model ReminderRule {
  id             String       @id @default(cuid(2))
  organizationId String
  type           ReminderType
  name           String
  isActive       Boolean      @default(true)
  steps          Json // [{ key:"J-30", offsetDays:-30, templateKey:"vt_j30", autoSend:true, channels:["WHATSAPP","SMS"] }, ...]
  sendWindow     Json // { days:[1,2,3,4,5,6], from:"08:00", to:"19:00" }
  conditions     Json         @default("{}") // { customerTypes:["INDIVIDUAL"], minAmount:5000, tags:[] }
  stopOn         String[] // ["appointment.created","payment.received","quote.accepted"]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  reminders    Reminder[]

  @@index([organizationId, type])
}

enum ReminderType {
  INSPECTION
  SERVICE
  RECEIVABLE
  APPOINTMENT
  QUOTE_FOLLOWUP
  VEHICLE_READY
  INSURANCE_EXPIRY
  SATISFACTION
  RECOMMENDED_WORK
  CUSTOM
}

model Reminder {
  // une occurrence planifiée
  id                String           @id @default(cuid(2))
  organizationId    String
  ruleId            String
  type              ReminderType
  stepKey           String // "J-30"
  customerId        String
  vehicleId         String?
  invoiceId         String?
  appointmentId     String?
  quoteId           String?
  dueDate           DateTime         @db.Date // échéance de référence (expiration VT, échéance facture…)
  scheduledFor      DateTime // quand l'envoyer
  status            ReminderStatus   @default(PLANNED)
  channel           Channel?
  renderedBody      String?
  approvedById      String?
  approvedAt        DateTime?
  sentAt            DateTime?
  skippedReason     String?
  snoozedUntil      DateTime?
  outcome           ReminderOutcome?
  outcomeAt         DateTime?
  dedupeKey         String // ex. "INSPECTION:veh_123:2026-11-02:J-30"
  // M10 §14 — regroupement, priorisation et traçabilité d'envoi (repris dès la Phase 0, cf. 04 §3)
  sequenceKey       String? // "INSPECTION:veh_123:2026-11-02" (sans le palier)
  groupKey          String? // regroupement d'envoi (RG-M10-15)
  messageId         String? // message M11 portant cette relance (partagé dans un groupe)
  priority          Int              @default(5) // RG-M10-16
  renderedSubject   String?
  editedBody        Boolean          @default(false)
  editedById        String?
  editedContext     Json?
  supersededById    String?
  approvalExpiresAt DateTime?
  deferCount        Int              @default(0) // reports anti-spam
  isCatchUp         Boolean          @default(false)
  attributedAmount  Int? // FCFA récupérés (créances)
  attributedRevenue Int? // CA de l'OR issu de la relance (VT, révision)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  organization          Organization  @relation(fields: [organizationId], references: [id])
  rule                  ReminderRule  @relation(fields: [ruleId], references: [id])
  customer              Customer      @relation(fields: [customerId], references: [id])
  vehicle               Vehicle?      @relation(fields: [vehicleId], references: [id])
  invoice               Invoice?      @relation(fields: [invoiceId], references: [id])
  quote                 Quote?        @relation(fields: [quoteId], references: [id])
  approvedBy            Membership?   @relation("ReminderApprovedBy", fields: [approvedById], references: [id])
  editedBy              Membership?   @relation("ReminderEditedBy", fields: [editedById], references: [id])
  supersededBy          Reminder?     @relation("ReminderSupersede", fields: [supersededById], references: [id])
  supersedes            Reminder[]    @relation("ReminderSupersede")
  appointment           Appointment?  @relation("ReminderAppointment", fields: [appointmentId], references: [id])
  triggeredAppointments Appointment[] @relation("AppointmentReminder")
  message               Message?      @relation("ReminderPrimaryMessage", fields: [messageId], references: [id])
  messages              Message[]     @relation("ReminderMessages")
  portalTokens          PortalToken[]

  @@unique([organizationId, dedupeKey])
  @@index([organizationId, status, scheduledFor])
  @@index([organizationId, sequenceKey])
  @@index([organizationId, customerId, status])
  @@index([organizationId, groupKey])
}

enum ReminderStatus {
  PLANNED
  NEEDS_APPROVAL
  QUEUED
  SENT
  FAILED
  SKIPPED
  SNOOZED
  CANCELLED
}

enum ReminderOutcome {
  APPOINTMENT_BOOKED
  PAID
  PARTIALLY_PAID
  PROMISED
  REPLIED
  NO_RESPONSE
  OPTED_OUT
  VISITED
  QUOTE_ACCEPTED
  VEHICLE_PICKED_UP
}

model ReminderSuppression {
  id             String        @id @default(cuid(2))
  organizationId String
  sequenceKey    String?
  customerId     String?
  vehicleId      String?
  type           ReminderType?
  until          DateTime? // null = permanente
  reason         String // "RDV pris le 24/10/2026", "VT effectuée", "Litige"
  source         String // appointment | inspection_done | staff | collection
  createdById    String?
  createdAt      DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  createdBy    Membership?  @relation("ReminderSuppressionCreatedBy", fields: [createdById], references: [id])

  @@index([organizationId, sequenceKey])
  @@index([organizationId, customerId, type])
  @@index([organizationId, vehicleId, type])
}

model MessageTemplate {
  id                     String        @id @default(cuid(2))
  organizationId         String
  key                    String // "vt_j30"
  name                   String
  channel                Channel
  subject                String? // email
  body                   String // avec variables {{client.prenom}}
  whatsappTemplateName   String? // nom du modèle approuvé chez Meta
  whatsappLanguage       String?       @default("fr")
  whatsappStatus         String? // APPROVED | PENDING | REJECTED
  isActive               Boolean       @default(true)
  // M11 §14
  type                   ReminderType? // classement dans l'éditeur
  isTransactional        Boolean       @default(false)
  whatsappCategory       String? // UTILITY | MARKETING | AUTHENTICATION (effective)
  whatsappParamMap       Json? // ["client.salutation","vehicule.marque",…]
  whatsappRejectedReason String?
  whatsappVersion        Int           @default(1)
  isDefault              Boolean       @default(true) // modèle livré non modifié
  updatedAt              DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, key, channel])
}

model QuickReply {
  // réponse rapide partagée dans l'organisation (M11 §14, RG-M11-22)
  id             String  @id @default(cuid(2))
  organizationId String
  title          String
  shortcut       String // "/prix-vidange"
  body           String
  templateKey    String? // modèle approuvé équivalent (hors fenêtre 24 h)
  createdById    String?

  organization Organization @relation(fields: [organizationId], references: [id])
  createdBy    Membership?  @relation("QuickReplyCreatedBy", fields: [createdById], references: [id])

  @@unique([organizationId, shortcut])
}

model Conversation {
  id                      String             @id @default(cuid(2))
  organizationId          String
  customerId              String?
  channel                 Channel
  externalAddress         String // téléphone ou email
  status                  ConversationStatus @default(OPEN)
  assignedToId            String?
  lastMessageAt           DateTime
  unreadCount             Int                @default(0)
  lastIntent              String? // classé par l'IA (M17)
  // M11 §14
  whatsappWindowExpiresAt DateTime?
  lastInboundAt           DateTime?
  candidateCustomerIds    String[] // numéro partagé, à trancher
  createdAt               DateTime           @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  customer     Customer?    @relation(fields: [customerId], references: [id])
  assignedTo   Membership?  @relation("ConversationAssignee", fields: [assignedToId], references: [id])
  messages     Message[]

  @@unique([organizationId, channel, externalAddress])
}

enum ConversationStatus {
  OPEN
  PENDING
  CLOSED
}

model Message {
  id                   String        @id @default(cuid(2))
  organizationId       String
  conversationId       String?
  customerId           String?
  reminderId           String?
  direction            Direction
  channel              Channel
  to                   String
  from                 String?
  subject              String?
  body                 String
  attachments          Json          @default("[]")
  status               MessageStatus @default(QUEUED)
  provider             String
  providerMessageId    String?
  errorCode            String?
  errorMessage         String?
  cost                 Int? // FCFA
  fallbackOfId         String? // message d'origine si repli (WhatsApp → SMS)
  idempotencyKey       String? // M11 §14 : unique par organisation/canal
  sentById             String? // null = automatique
  // M11 §14
  kind                 MessageKind   @default(REMINDER)
  templateKey          String?
  whatsappTemplateName String? // modèle Meta réellement utilisé
  intent               String? // classement M17 (entrants)
  intentConfidence     Float?
  attemptCount         Int           @default(0)
  nextRetryAt          DateTime?
  failedAt             DateTime?
  createdAt            DateTime      @default(now())
  sentAt               DateTime?
  deliveredAt          DateTime?
  readAt               DateTime?

  organization        Organization         @relation(fields: [organizationId], references: [id])
  conversation        Conversation?        @relation(fields: [conversationId], references: [id])
  customer            Customer?            @relation(fields: [customerId], references: [id])
  reminder            Reminder?            @relation("ReminderMessages", fields: [reminderId], references: [id])
  primaryForReminders Reminder[]           @relation("ReminderPrimaryMessage")
  fallbackOf          Message?             @relation("MessageFallback", fields: [fallbackOfId], references: [id])
  fallbacks           Message[]            @relation("MessageFallback")
  sentBy              Membership?          @relation("MessageSentBy", fields: [sentById], references: [id])
  statusEvents        MessageStatusEvent[]
  attempts            MessageAttempt[]

  @@unique([organizationId, idempotencyKey, channel])
  @@index([organizationId, providerMessageId])
  @@index([organizationId, customerId, createdAt])
  @@index([organizationId, status, createdAt])
}

enum Direction {
  OUTBOUND
  INBOUND
}

enum MessageKind {
  REMINDER
  TRANSACTIONAL
  CONVERSATION
  DIGEST
  SYSTEM
}

enum MessageStatus {
  QUEUED
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
  RECEIVED
}

model MessageStatusEvent {
  // idempotence des webhooks de statut (M11 §14)
  id                String        @id @default(cuid(2))
  organizationId    String
  messageId         String
  providerMessageId String
  status            MessageStatus
  occurredAt        DateTime

  organization Organization @relation(fields: [organizationId], references: [id])
  message      Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([providerMessageId, status])
  @@index([organizationId, messageId])
}

model MessageAttempt {
  // une tentative d'envoi fournisseur (M11 §14, RG-M11-07)
  id             String    @id @default(cuid(2))
  organizationId String
  messageId      String
  attempt        Int
  startedAt      DateTime
  finishedAt     DateTime?
  outcome        String // OK | TEMPORARY | PERMANENT_RECIPIENT | PERMANENT_TEMPLATE | PERMANENT_CONFIG | RATE_LIMIT
  providerCode   String?
  providerRaw    Json?

  organization Organization @relation(fields: [organizationId], references: [id])
  message      Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([organizationId, messageId])
}

model ChannelConfig {
  id                 String    @id @default(cuid(2))
  organizationId     String
  channel            Channel
  provider           String // whatsapp_cloud | wa_link | orange_sms | twilio | http_sms | smtp | resend | console
  isActive           Boolean   @default(false)
  priority           Int       @default(1)
  credentials        String // JSON chiffré (AES-256-GCM)
  senderId           String? // nom d'expéditeur SMS, numéro WhatsApp, email from
  status             String? // OK | ERROR
  lastCheckedAt      DateTime?
  balance            Int? // crédit SMS restant si disponible
  // M11 §14
  webhookVerifyToken String?
  messagingTier      String? // palier de messagerie WhatsApp
  lastError          String?

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, channel, provider])
}

model OptOut {
  id             String   @id @default(cuid(2))
  organizationId String
  address        String // téléphone ou email
  channel        Channel?
  reason         String?
  createdAt      DateTime @default(now())
  // M11 §14
  source         String? // keyword | email_link | staff | complaint
  messageId      String?

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, address, channel])
}

// ═══════════════════════════════════════════════════════════════
// Paramètres fournisseurs paiement / FNE
// ═══════════════════════════════════════════════════════════════

model PaymentProviderConfig {
  id             String          @id @default(cuid(2))
  organizationId String
  provider       String // cinetpay | wave
  isActive       Boolean         @default(false)
  credentials    String // chiffré
  methods        PaymentMethod[]

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, provider])
}

model FneConfig {
  id              String  @id @default(cuid(2))
  organizationId  String  @unique
  mode            String  @default("manual") // api | manual | disabled
  credentials     String? // chiffré
  establishmentId String?
  pointOfSale     String?
  isActive        Boolean @default(false)

  organization Organization @relation(fields: [organizationId], references: [id])
}

// ═══════════════════════════════════════════════════════════════
// Import / synchronisation
// ═══════════════════════════════════════════════════════════════

model DataSource {
  id             String         @id @default(cuid(2))
  organizationId String
  type           DataSourceType
  name           String
  config         String // JSON chiffré : chemin, connexion SQL, requêtes, mapping
  mapping        Json           @default("{}")
  schedule       String? // cron
  isActive       Boolean        @default(true)
  lastRunAt      DateTime?
  lastStatus     String?

  organization Organization  @relation(fields: [organizationId], references: [id])
  importJobs   ImportJob[]
  externalRefs ExternalRef[]

  @@index([organizationId])
}

enum DataSourceType {
  FILE_UPLOAD
  WATCHED_FOLDER
  SQL_DATABASE
  REST_API
  WEBHOOK
}

model ImportJob {
  id              String       @id @default(cuid(2))
  organizationId  String
  dataSourceId    String?
  entity          String // customers | vehicles | invoices | payments | products | repair_orders | mixed
  fileUrl         String?
  fileName        String?
  encoding        String? // UTF-8 | UTF-8-BOM | UTF-16 | WINDOWS-1252 | ISO-8859-1 (RG-M13-02)
  delimiter       String? // ; , \t | (RG-M13-03, CSV uniquement)
  headerSignature String? // sha256 des en-têtes normalisés triés (RG-M13-08)
  mapping         Json         @default("{}") // { columns: {...}, options: {...} } (imports.setMapping)
  policy          ImportPolicy @default(UPSERT)
  status          ImportStatus @default(PENDING)
  dryRun          Boolean      @default(false)
  totalRows       Int          @default(0)
  processedRows   Int          @default(0)
  createdCount    Int          @default(0)
  updatedCount    Int          @default(0)
  unchangedCount  Int          @default(0)
  skippedCount    Int          @default(0)
  errorCount      Int          @default(0)
  warningCount    Int          @default(0)
  summary         Json? // échantillon avant/après de la simulation (imports.simulate)
  errorReportUrl  String? // clé S3 du rapport d'erreurs .xlsx
  startedAt       DateTime?
  finishedAt      DateTime?
  rolledBackAt    DateTime?
  createdById     String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id])
  dataSource   DataSource?      @relation(fields: [dataSourceId], references: [id])
  createdBy    Membership?      @relation("ImportJobCreatedBy", fields: [createdById], references: [id])
  errors       ImportRowError[]

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
}

enum ImportPolicy {
  CREATE_ONLY
  UPSERT
  UPSERT_OVERWRITE
}

enum ImportStatus {
  PENDING
  VALIDATING
  READY
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  ROLLED_BACK
}

model ImportRowError {
  id             String  @id @default(cuid(2))
  organizationId String
  importJobId    String
  rowNumber      Int
  field          String?
  message        String
  severity       String  @default("ERROR") // ERROR | WARNING (RG-M13-16)
  raw            Json

  organization Organization @relation(fields: [organizationId], references: [id])
  importJob    ImportJob    @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@index([organizationId, importJobId])
}

model ExternalRef {
  // lien entre un enregistrement et son ID dans le logiciel source
  id             String    @id @default(cuid(2))
  organizationId String
  dataSourceId   String
  entity         String
  externalId     String
  internalId     String
  hash           String? // détection des changements
  importJobId    String? // dernier job ayant écrit (rollback)
  lastSeenAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  dataSource   DataSource   @relation(fields: [dataSourceId], references: [id])

  @@unique([dataSourceId, entity, externalId])
  @@index([organizationId])
}

model ApiKey {
  id             String    @id @default(cuid(2))
  organizationId String
  name           String
  keyHash        String    @unique
  prefix         String // affiché : "ak_live_3f9a…"
  scopes         String[]
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model WebhookEndpoint {
  // webhooks sortants vers d'autres systèmes
  id             String   @id @default(cuid(2))
  organizationId String
  url            String
  secret         String
  events         String[]
  isActive       Boolean  @default(true)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

// ═══════════════════════════════════════════════════════════════
// Assurances
// ═══════════════════════════════════════════════════════════════

model InsuranceCompany {
  id               String  @id @default(cuid(2))
  organizationId   String
  name             String
  phone            String?
  email            String?
  paymentTermsDays Int     @default(60)

  organization Organization     @relation(fields: [organizationId], references: [id])
  vehicles     Vehicle[]
  claims       InsuranceClaim[]

  @@index([organizationId])
}

model InsuranceClaim {
  id                 String      @id @default(cuid(2))
  organizationId     String
  insuranceCompanyId String
  customerId         String
  vehicleId          String
  claimNumber        String?
  policyNumber       String?
  accidentDate       DateTime?   @db.Date
  expertName         String?
  expertVisitAt      DateTime?
  status             ClaimStatus @default(OPENED)
  deductible         Int         @default(0) // franchise client
  approvedAmount     Int?
  notes              String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  organization     Organization     @relation(fields: [organizationId], references: [id])
  insuranceCompany InsuranceCompany @relation(fields: [insuranceCompanyId], references: [id])
  customer         Customer         @relation(fields: [customerId], references: [id])
  vehicle          Vehicle          @relation(fields: [vehicleId], references: [id])
  repairOrders     RepairOrder[]
  invoices         Invoice[]

  @@index([organizationId, status])
}

enum ClaimStatus {
  OPENED
  EXPERT_SCHEDULED
  ESTIMATE_SENT
  APPROVED
  REPAIRING
  INVOICED
  PAID
  REJECTED
}

// ═══════════════════════════════════════════════════════════════
// Transverse
// ═══════════════════════════════════════════════════════════════

model Attachment {
  id             String   @id @default(cuid(2))
  organizationId String
  entity         String // repair_order | vehicle | invoice | claim | inspection_item
  entityId       String
  kind           String // photo_checkin | photo_damage | signature | document
  url            String
  mimeType       String
  size           Int
  caption        String?
  createdById    String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  createdBy    Membership?  @relation("AttachmentCreatedBy", fields: [createdById], references: [id])

  @@index([organizationId, entity, entityId])
}

model DocumentSequence {
  id             String  @id @default(cuid(2))
  organizationId String
  siteId         String?
  docType        String // OR | DEV | FAC | AV | REC | BC
  year           Int
  lastValue      Int     @default(0)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, siteId, docType, year])
}

model AuditLog {
  id             String   @id @default(cuid(2))
  organizationId String
  userId         String?
  membershipId   String?
  siteId         String?
  action         String // invoice.void, stock.adjust…
  entity         String
  entityId       String
  before         Json?
  after          Json?
  reason         String?
  ip             String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User?        @relation(fields: [userId], references: [id])

  @@index([organizationId, entity, entityId])
  @@index([organizationId, createdAt])
  @@index([organizationId, action])
}

// ═══════════════════════════════════════════════════════════════
// Authentification (Better Auth), invitations, permissions par rôle
// ═══════════════════════════════════════════════════════════════

model Session {
  id                   String   @id @default(cuid(2))
  userId               String
  token                String   @unique
  expiresAt            DateTime
  ipAddress            String?
  userAgent            String?
  activeOrganizationId String?
  activeSiteId         String? // null = « Tous les sites »
  isPinSession         Boolean  @default(false)
  deviceId             String?
  lastActiveAt         DateTime @default(now())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  // identifiants Better Auth (credential = mot de passe argon2id)
  id         String   @id @default(cuid(2))
  userId     String
  providerId String // "credential"
  accountId  String
  password   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  // OTP et jetons de réinitialisation (Better Auth)
  id         String   @id @default(cuid(2))
  identifier String // "+2250708123456:RESET"
  value      String // code haché
  attempts   Int      @default(0)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([identifier])
}

model TrustedDevice {
  id                     String    @id @default(cuid(2))
  organizationId         String?
  userId                 String? // null si appareil partagé d'atelier
  deviceId               String // identifiant aléatoire stocké en cookie httpOnly
  label                  String? // "Tablette atelier 1"
  isSharedWorkshopDevice Boolean   @default(false)
  siteId                 String?
  expiresAt              DateTime?
  createdAt              DateTime  @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@unique([deviceId])
}

model Invitation {
  id             String           @id @default(cuid(2))
  organizationId String
  name           String
  email          String?
  phone          String? // E.164
  role           Role
  siteIds        String[]
  permissions    String[]
  tokenHash      String           @unique
  channel        Channel?
  status         InvitationStatus @default(PENDING)
  invitedById    String // Membership.id
  expiresAt      DateTime
  acceptedAt     DateTime?
  acceptedUserId String?
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, status])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model RolePermission {
  // Permissions par défaut d'un rôle, surchargées par l'organisation
  id             String   @id @default(cuid(2))
  organizationId String
  role           Role
  permissions    String[]
  updatedById    String?
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, role])
}

model DomainEvent {
  id             String    @id @default(cuid(2))
  organizationId String
  type           String
  payload        Json
  occurredAt     DateTime  @default(now())
  processedAt    DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, type, occurredAt])
}

model Notification {
  // notifications internes de l'application
  id             String    @id @default(cuid(2))
  organizationId String
  membershipId   String
  type           String
  title          String
  body           String?
  link           String?
  readAt         DateTime?
  createdAt      DateTime  @default(now())
  // M12 §14 — alertes (RG-M12-27/28)
  severity       String? // info | warning | critical
  dedupeKey      String? // "alert.channel_error:cc_123:2026-10-18" (une fois par objet et par jour)

  organization Organization @relation(fields: [organizationId], references: [id])
  membership   Membership   @relation(fields: [membershipId], references: [id])

  @@unique([organizationId, membershipId, dedupeKey])
  @@index([organizationId, membershipId, readAt])
}

model AiInteraction {
  // trace des appels IA (coût, qualité)
  id             String   @id @default(cuid(2))
  organizationId String
  feature        String // quote_draft | intent_classification | …
  inputRef       String?
  output         Json
  accepted       Boolean? // l'utilisateur a-t-il gardé la suggestion
  tokensIn       Int?
  tokensOut      Int?
  createdById    String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  createdBy    Membership?  @relation("AiInteractionCreatedBy", fields: [createdById], references: [id])

  @@index([organizationId, feature])
}

// ═══════════════════════════════════════════════════════════════
// Phase 0 — ajouts transverses (04-arbitrages-coherence.md §3)
// ═══════════════════════════════════════════════════════════════

model Holiday {
  // jours fériés — source unique (A1), M15 §14
  id             String   @id @default(cuid(2))
  organizationId String
  siteId         String? // null = tous les sites
  date           DateTime @db.Date
  name           String // "Fête de l'Indépendance"
  kind           String   @default("PUBLIC") // PUBLIC | CLOSURE
  isEstimated    Boolean  @default(false) // fêtes religieuses à confirmer

  organization Organization @relation(fields: [organizationId], references: [id])
  site         Site?        @relation(fields: [siteId], references: [id])

  @@unique([organizationId, siteId, date])
}

model PortalToken {
  // liens publics du portail — mécanisme unique (A2), M14 §14
  id             String            @id @default(cuid(2))
  organizationId String
  tokenHash      String            @unique // sha256 du jeton clair
  shortCode      String?           @unique // alias SMS /l/{code}
  scope          PortalScope
  targetId       String // id de la ressource ciblée
  customerId     String
  status         PortalTokenStatus @default(ACTIVE)
  expiresAt      DateTime
  createdById    String? // null = automatique
  reminderId     String? // relance ayant généré le lien
  firstOpenedAt  DateTime?
  lastOpenedAt   DateTime?
  openCount      Int               @default(0)
  revokedAt      DateTime?
  revokeReason   String?
  createdAt      DateTime          @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  customer     Customer     @relation(fields: [customerId], references: [id])
  createdBy    Membership?  @relation("PortalTokenCreatedBy", fields: [createdById], references: [id])
  reminder     Reminder?    @relation(fields: [reminderId], references: [id])
  // targetId est polymorphe (scope détermine la table cible : Quote, Invoice, RepairOrder, Appointment, Vehicle…) : pas de @relation unique possible.

  @@index([organizationId, scope, targetId])
}

enum PortalScope {
  QUOTE
  INVOICE
  REPAIR_ORDER
  APPOINTMENT
  BOOKING
  VEHICLE
  STATEMENT
  SURVEY
}

enum PortalTokenStatus {
  ACTIVE
  EXPIRED
  REVOKED
}
