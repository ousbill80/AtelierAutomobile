# Voir docs/01-architecture-technique.md §9
DATABASE_URL=postgresql://atelieros:atelieros@localhost:55432/atelieros?schema=public
# Rôle restreint (sans BYPASSRLS) utilisé par db.forTenant() — voir packages/db/src/tenant.ts
DATABASE_APP_URL=postgresql://atelieros_app:atelieros_app@localhost:55432/atelieros?schema=public
REDIS_URL=redis://localhost:6380
APP_URL=http://localhost:3000
# "production" en déploiement réel uniquement : masque /dev/outbox (RG-M11-26) et refuse un
# fournisseur de messagerie "console" actif (garde au démarrage, apps/worker). Distinct de
# NODE_ENV, qui vaut toujours "production" pour un build Next.js (y compris en test/CI).
APP_ENV=development

# M13 — file « imports » (RG-M13-24) : "inline" (défaut, pas de worker séparé
# requis — tests et `pnpm dev` sans worker) ou "bullmq" (consommée par
# `apps/worker`, nécessite Redis).
IMPORT_QUEUE_DRIVER=bullmq

# 32 octets en base64 — genere avec: openssl rand -base64 32
ENCRYPTION_KEY=
AUTH_SECRET=

S3_ENDPOINT=http://localhost:9000
S3_BUCKET=atelieros-dev
S3_ACCESS_KEY=atelieros
S3_SECRET_KEY=atelieros123

ANTHROPIC_API_KEY=
# Réservé usage futur M17 (IA et automatisations) — aucun code ne les lit encore
KIMI_API_KEY=
OPENROUTER_API_KEY=
SENTRY_DSN=

DEFAULT_TIMEZONE=Africa/Abidjan
