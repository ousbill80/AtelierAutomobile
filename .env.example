# Voir docs/01-architecture-technique.md §9
DATABASE_URL=postgresql://atelieros:atelieros@localhost:55432/atelieros?schema=public
# Rôle restreint (sans BYPASSRLS) utilisé par db.forTenant() — voir packages/db/src/tenant.ts
DATABASE_APP_URL=postgresql://atelieros_app:atelieros_app@localhost:55432/atelieros?schema=public
REDIS_URL=redis://localhost:6380
APP_URL=http://localhost:3000
# "production" en déploiement réel uniquement : masque /dev/outbox (RG-M11-26) et refuse un
# fournisseur de messagerie "console" actif (garde au démarrage, apps/worker). Distinct de
# NODE_ENV, qui vaut toujours "production" pour un build Next.js (y compris en test/CI).
APP_ENV=development

# M13 — file « imports » (RG-M13-24) : "inline" (défaut, pas de worker séparé
# requis — tests et `pnpm dev` sans worker) ou "bullmq" (consommée par
# `apps/worker`, nécessite Redis).
IMPORT_QUEUE_DRIVER=bullmq

# 32 octets en base64 — genere avec: openssl rand -base64 32
ENCRYPTION_KEY=
AUTH_SECRET=

# M04 — pièces jointes d'OR (photos, signatures) : "s3" (défaut, MinIO/S3) ou "local"
# (disque, LOCAL_STORAGE_DIR, défaut apps/web/.data/uploads) pour travailler sans MinIO.
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=atelieros-dev
S3_ACCESS_KEY=atelieros
S3_SECRET_KEY=atelieros123
# Production (docker-compose.prod.yml) : adresse interne MinIO et adresse vue du navigateur.
# S3_ENDPOINT=http://minio:9000
# S3_PUBLIC_ENDPOINT=https://atelier.exemple.ci/storage
# S3_REGION=us-east-1

# Production uniquement — voir docs/exploitation.md
# APP_DOMAIN=atelier.exemple.ci
# POSTGRES_USER=atelieros
# POSTGRES_PASSWORD=
# POSTGRES_DB=atelieros
# POSTGRES_APP_PASSWORD=
# REDIS_PASSWORD=
# BACKUP_ENCRYPTION_KEY=
# SENTRY_ENVIRONMENT=production
# ATELIEROS_VERSION=

ANTHROPIC_API_KEY=
# Réservé usage futur — aucun code ne les lit encore (M17 utilise ANTHROPIC_API_KEY)
KIMI_API_KEY=
OPENROUTER_API_KEY=
SENTRY_DSN=

DEFAULT_TIMEZONE=Africa/Abidjan

# M17 — IA : "claude" (API Anthropic, ANTHROPIC_API_KEY requise) ou "console" (réponses
# déterministes, local/tests). Vide : claude si ANTHROPIC_API_KEY est renseignée, sinon console.
# Compte API à configurer sans conservation des données pour l'entraînement (RG-M17-04).
AI_PROVIDER=
AI_MODEL=claude-opus-5-5
# Modèle léger optionnel (classification, mapping) ; vide = AI_MODEL.
AI_MODEL_FAST=

# M15 — facturation de l'abonnement AtelierOS : "manual" (défaut : demande transmise à
# l'équipe commerciale, plan inchangé) ou "fake" (changement appliqué immédiatement, local/tests,
# interdit si APP_ENV=production).
SUBSCRIPTION_BILLING_PROVIDER=manual
