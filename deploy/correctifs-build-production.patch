diff --git a/src/types/page-flip.d.ts b/src/types/page-flip.d.ts
new file mode 100644
index 0000000..9bfaa1f
--- /dev/null
+++ b/src/types/page-flip.d.ts
@@ -0,0 +1,17 @@
+/**
+ * `page-flip` (2.0.7) ne livre aucune définition de types, et son champ `main`
+ * pointe un bundle UMD qui s'enregistre sur un objet global (`St`) au lieu
+ * d'exporter `PageFlip`. Le lecteur du code de l'assainissement importe donc
+ * directement le build ESM `dist/js/page-flip.module.js`, seul à fournir
+ * `export { PageFlip }`.
+ *
+ * Sans cette déclaration, TypeScript refuse ce chemin d'import (TS7016 : type
+ * `any` implicite) et `next build` échoue au type-check.
+ *
+ * `PageFlip` est volontairement typé en `unknown` : le composant le caste déjà
+ * vers son propre contrat (`FlipApi` dans `CodeDocumentReader.tsx`), et
+ * décrire ici une surface d'API non vérifiable donnerait une fausse garantie.
+ */
+declare module "page-flip/dist/js/page-flip.module.js" {
+  export const PageFlip: unknown;
+}
