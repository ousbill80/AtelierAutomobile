{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalPassThroughEnv": [
    "CI",
    "DATABASE_URL",
    "DATABASE_APP_URL",
    "REDIS_URL",
    "APP_URL",
    "APP_ENV",
    "S3_ENDPOINT",
    "S3_BUCKET",
    "S3_ACCESS_KEY",
    "S3_SECRET_KEY",
    "STORAGE_DRIVER",
    "LOCAL_STORAGE_DIR",
    "ENCRYPTION_KEY",
    "AUTH_SECRET",
    "DEFAULT_TIMEZONE",
    "ANTHROPIC_API_KEY",
    "SENTRY_DSN",
    "PLAYWRIGHT_CHROMIUM_PATH"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:e2e": {
      "dependsOn": ["build"]
    }
  }
}
